<ol class="combat-tracker plain">
  {{#each turns}}
  <li class="combatant {{ css }}" data-combatant-id="{{ id }}" data-action="activateCombatant"
      {{#if @root.manualOrderEditable}}draggable="true" aria-label="{{ localize "CYPHERV2.CombatTracker.Reorder" name=name }}"{{/if}}>
    <img class="token-image" src="{{ img }}" alt="{{ name }}" loading="lazy">

    <div class="token-name">
      <strong class="name">{{ name }}</strong>
      <div class="combatant-controls">
        {{#if @root.user.isGM}}
        <button type="button" class="inline-control combatant-control icon fa-solid fa-eye-slash {{#if hidden}}active{{/if}}"
                data-action="toggleHidden" data-tooltip aria-label="{{ localize "COMBATANT.ToggleVis" }}"></button>
        <button type="button" class="inline-control combatant-control icon fa-solid fa-skull {{#if isDefeated}}active{{/if}}"
                data-action="toggleDefeated" data-tooltip aria-label="{{ localize "COMBATANT.ToggleDead" }}"></button>
        {{/if}}
        {{#if canPing}}
        <button type="button" class="inline-control combatant-control icon fa-solid fa-bullseye-arrow"
                data-action="pingCombatant" data-tooltip aria-label="{{ localize "COMBATANT.Ping" }}"></button>
        {{/if}}
        {{#unless @root.user.isGM}}
        <button type="button" class="inline-control combatant-control icon fa-solid fa-arrows-to-eye"
                data-action="panToCombatant" data-tooltip aria-label="{{ localize "COMBATANT.PanTo" }}"></button>
        {{/unless}}
        <div class="token-effects" data-tooltip-html="{{ effects.tooltip }}">
          {{#each effects.icons}}<img class="token-effect" src="{{ img }}" alt="{{ name }}">{{/each}}
        </div>
      </div>
    </div>

    {{#if resource includeZero=true}}
    <div class="token-resource"><span class="resource">{{ resource }}</span></div>
    {{/if}}

    <div class="token-initiative cypherv2-turn-action">
      {{#if canEndTurn}}
      <button type="button" class="combatant-control cypherv2-done-control" data-action="endCypherTurn"
              data-tooltip="CYPHERV2.CombatTracker.EndTurn"
              aria-label="{{ localize "CYPHERV2.CombatTracker.DoneAria" }}">
        <i class="fa-solid fa-check" inert></i>
        <span>{{ localize "CYPHERV2.CombatTracker.Done" }}</span>
      </button>
      {{else if doneThisRound}}
      <span class="cypherv2-done-status" aria-label="{{ localize "CYPHERV2.CombatTracker.DoneStatusAria" }}">
        <i class="fa-solid fa-check" inert></i>
        <span>{{ localize "CYPHERV2.CombatTracker.Done" }}</span>
      </span>
      {{/if}}
    </div>
  </li>
  {{/each}}
</ol>
