              <button type="button" class="cypherv2-icon-action" data-action="editSkill" data-item-id="{{skill.id}}" title="{{localize 'CYPHERV2.Actions.Edit'}}" aria-label="{{localize 'CYPHERV2.Actions.Edit'}} {{skill.name}}"><i class="fa-solid fa-pen"></i></button>
              <button type="button" class="cypherv2-icon-action" data-action="deleteSkill" data-item-id="{{skill.id}}" title="{{localize 'CYPHERV2.Actions.Delete'}}" aria-label="{{localize 'CYPHERV2.Actions.Delete'}} {{skill.name}}"><i class="fa-solid fa-trash"></i></button>
