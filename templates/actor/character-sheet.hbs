          {{#each inventory.equipment as |item|}}
            <li class="compact-inventory-item {{#if item.expanded}}is-expanded{{/if}}" data-item-id="{{item.id}}">
              <div class="compact-inventory-row">
                <button type="button" class="inventory-details-toggle cypherv2-icon-action" data-action="toggleInventoryDetails" data-item-id="{{item.id}}" aria-expanded="{{item.expanded}}" aria-controls="inventory-details-{{item.id}}" aria-label="{{localize 'CYPHERV2.Inventory.ToggleDetails'}}: {{item.name}}"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
