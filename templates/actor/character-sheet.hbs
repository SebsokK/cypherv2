          {{#if editable}}<button type="button" class="inventory-add-action cypherv2-primary-action" data-action="createInventoryItem" data-item-type="cypher" title="{{localize 'CYPHERV2.Inventory.AddCypher'}}" aria-label="{{localize 'CYPHERV2.Inventory.AddCypher'}}"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>{{/if}}
        </header>
        <ol class="compact-inventory-list">
          {{#each inventory.cyphers as |item|}}
            <li class="compact-inventory-item {{#if item.expanded}}is-expanded{{/if}}" data-item-id="{{item.id}}">
              <div class="compact-inventory-row">
                <button type="button" class="inventory-details-toggle cypherv2-icon-action" data-action="toggleInventoryDetails" data-item-id="{{item.id}}" aria-expanded="{{item.expanded}}" aria-controls="inventory-details-{{item.id}}" aria-label="{{localize 'CYPHERV2.Inventory.ToggleDetails'}}: {{item.name}}"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
                <button type="button" class="inventory-item-name cypherv2-primary-action" data-action="openInventoryItem" data-item-id="{{item.id}}">{{item.name}}</button>
                <span class="inventory-power is-{{item.power}}"><i aria-hidden="true"></i>{{item.powerLabel}}</span>
                <span class="inventory-item-actions"><button type="button" class="cypherv2-icon-action" data-action="sendItemToChat" data-item-id="{{item.id}}" title="{{localize 'CYPHERV2.Inventory.SendToChat'}}" aria-label="{{localize 'CYPHERV2.Inventory.SendToChat'}} {{item.name}}"><i class="fa-solid fa-message" aria-hidden="true"></i></button><button type="button" class="cypherv2-icon-action" data-action="openInventoryItem" data-item-id="{{item.id}}" title="{{localize 'CYPHERV2.Actions.Edit'}}" aria-label="{{localize 'CYPHERV2.Actions.Edit'}} {{item.name}}"><i class="fa-solid fa-pen" aria-hidden="true"></i></button>{{#if ../editable}}<button type="button" class="cypherv2-icon-action" data-action="deleteInventoryItem" data-item-id="{{item.id}}" title="{{localize 'CYPHERV2.Actions.Delete'}}" aria-label="{{localize 'CYPHERV2.Actions.Delete'}} {{item.name}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>{{/if}}</span>
              </div>
              <section id="inventory-details-{{item.id}}" class="compact-inventory-details" {{#unless item.expanded}}hidden{{/unless}}>{{#if item.hasDescription}}{{{item.enrichedDescription}}}{{else}}<p>{{localize "CYPHERV2.Inventory.NoDescription"}}</p>{{/if}}</section>
