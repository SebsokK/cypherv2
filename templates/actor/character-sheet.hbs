                <span class="inventory-artifact-identity"><button type="button" class="inventory-item-name cypherv2-primary-action" data-action="openInventoryItem" data-item-id="{{item.id}}">{{item.name}}</button>{{#if item.canRollLevel}}<button type="button" class="inventory-level inventory-rollable" data-action="rollArtifactLevel" data-item-id="{{item.id}}" title="{{localize 'CYPHERV2.Artifact.RollLevel'}}">({{localize "CYPHERV2.Inventory.Level"}} {{item.level}}) <i class="fa-solid fa-dice" aria-hidden="true"></i></button>{{else}}<span class="inventory-level">({{localize "CYPHERV2.Inventory.Level"}} <strong>{{item.level}}</strong>)</span>{{/if}}</span>
