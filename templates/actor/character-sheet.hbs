<div class="cypherv2-sheet cypherv2-character" style="{{header.appearance.style}}">
  {{#unless coreCreation.coreInitialized}}
    <section class="core-setup-banner">
      <div><strong>{{localize "CYPHERV2.Creation.Required"}}</strong><p>{{localize "CYPHERV2.Creation.RequiredHint"}}</p></div>
      <div class="core-action-bar">
        <button type="button" data-action="beginCoreSetup">{{localize "CYPHERV2.Creation.Begin"}}</button>
        {{#if isGM}}
          <button type="button" data-action="skipCoreSetup">{{localize "CYPHERV2.Creation.Skip"}}</button>
          <button type="button" data-action="markCoreInitialized">{{localize "CYPHERV2.Creation.MarkInitialized"}}</button>
        {{/if}}
      </div>
    </section>
  {{/unless}}
  <header class="sheet-header cypherv2-character-hud {{#if header.appearance.hasBackgroundImage}}has-header-background{{/if}} {{#if header.appearance.hasCharacterColor}}has-character-color{{/if}}" aria-label="{{localize 'CYPHERV2.Hud.Title'}}">
    <div class="character-hud-topline">
      <section class="character-hud-identity">
        <img class="character-hud-avatar" src="{{actor.img}}" alt="{{actor.name}}" data-edit="img" {{#if editable}}data-action="editImage" role="button" tabindex="0" title="{{localize 'CYPHERV2.Common.EditImage'}}"{{/if}}>
        <div class="character-hud-identity-copy">
          <div class="character-hud-name-row">
            <input class="character-hud-name" name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'CYPHERV2.Common.Name'}}" {{#unless editable}}readonly{{/unless}}>
            {{#if header.playerIntrusion.visible}}<button type="button" class="character-player-intrusion cypherv2-icon-action" data-action="playerIntrusion" title="{{header.playerIntrusion.tooltip}}" aria-label="{{header.playerIntrusion.tooltip}}" {{#unless header.playerIntrusion.canUse}}disabled aria-disabled="true"{{/unless}}><i class="fa-solid fa-bolt" aria-hidden="true"></i></button>{{/if}}
          </div>
          <p class="character-hud-sentence" aria-label="{{header.identity.sentence}}">
            <span>{{localize "CYPHERV2.Hud.IAm"}} {{header.identity.article}}</span>
            {{#each header.identity.descriptors as |descriptor|}}
              {{#if descriptor.missing}}
                <span class="character-hud-identity-slot is-missing" data-hud-drop="descriptor" title="{{localize 'CYPHERV2.Hud.DropDescriptor'}}">{{descriptor.displayName}}</span>
              {{else}}
                <button type="button" class="character-hud-identity-slot cypherv2-primary-action" data-action="inspectPackage" data-item-id="{{descriptor.id}}">{{descriptor.displayName}}</button>
              {{/if}}
              {{#unless @last}}<span>{{localize "CYPHERV2.Hud.And"}}</span>{{/unless}}
            {{/each}}
            {{#if header.identity.species}}
              <button type="button" class="character-hud-identity-slot cypherv2-primary-action" data-action="inspectPackage" data-item-id="{{header.identity.species.id}}">{{header.identity.species.displayName}}</button>
            {{/if}}
            {{#if header.identity.type.missing}}
              <span class="character-hud-identity-slot is-missing" data-hud-drop="characterType" title="{{localize 'CYPHERV2.Hud.DropType'}}">{{header.identity.type.displayName}}</span>
            {{else}}
              <button type="button" class="character-hud-identity-slot cypherv2-primary-action" data-action="inspectPackage" data-item-id="{{header.identity.type.id}}">{{header.identity.type.displayName}}</button>
            {{/if}}
            <span>{{localize "CYPHERV2.Hud.Who"}}</span>
            {{#if header.identity.focus.missing}}
              <span class="character-hud-identity-slot is-missing" data-hud-drop="focus" title="{{localize 'CYPHERV2.Hud.DropFocus'}}">{{header.identity.focus.displayName}}</span>
            {{else}}
              <button type="button" class="character-hud-identity-slot cypherv2-primary-action" data-action="inspectHeaderFocus" data-focus-uuid="{{header.identity.focus.uuid}}">{{header.identity.focus.displayName}}</button>
            {{/if}}
          </p>
        </div>
      </section>

      <section class="character-hud-core-stats character-hud-stat-stack" aria-label="{{localize 'CYPHERV2.Hud.CoreStats'}}">
        <span class="character-hud-stat-box"><small>{{localize "CYPHERV2.Character.Tier"}}</small>{{#if editable}}<button type="button" class="character-hud-stat-value cypherv2-primary-action" data-action="editCharacterOverride" data-override-key="tier">{{header.stats.tier}}</button>{{else}}<strong class="character-hud-stat-value">{{header.stats.tier}}</strong>{{/if}}</span>
        <span class="character-hud-stat-box"><small>{{localize "CYPHERV2.Character.Effort"}}</small>{{#if editable}}<button type="button" class="character-hud-stat-value cypherv2-primary-action" data-action="editCharacterOverride" data-override-key="effort">{{header.stats.effort}}</button>{{else}}<strong class="character-hud-stat-value">{{header.stats.effort}}</strong>{{/if}}</span>
      </section>
    </div>

    <section class="character-hud-pools" aria-label="{{localize 'CYPHERV2.Character.Pools'}}">
      {{#each header.pools as |pool|}}
        <article class="character-hud-card character-hud-pool" data-action="rollPool" data-pool="{{pool.key}}" role="button" tabindex="0" aria-label="{{localize 'CYPHERV2.Hud.RollPool'}} {{pool.label}}">
          <strong class="character-hud-card-title">{{pool.label}}</strong>
          <div class="character-hud-pool-value">
            {{#if ../editable}}<input name="system.stats.{{pool.key}}.value" type="number" data-dtype="Number" value="{{pool.value}}" min="0" aria-label="{{pool.label}} {{localize 'CYPHERV2.Pools.Value'}}">{{else}}<strong>{{pool.value}}</strong>{{/if}}
            <span>/ {{#if ../editable}}<button type="button" class="character-hud-effective-value cypherv2-primary-action" data-action="editCharacterOverride" data-override-key="{{pool.key}}Max">{{pool.max}}</button>{{else}}{{pool.max}}{{/if}}</span>
          </div>
          <span class="character-hud-pool-gauge" style="--cypherv2-pool-gauge-ratio: {{pool.gauge.ratio}}" aria-hidden="true"><i></i></span>
          <div class="character-hud-pool-meta">
            <small>{{localize "CYPHERV2.Pools.Edge"}} {{#if ../editable}}<button type="button" class="character-hud-effective-value cypherv2-primary-action" data-action="editCharacterOverride" data-override-key="{{pool.key}}Edge">{{pool.edge}}</button>{{else}}<strong>{{pool.edge}}</strong>{{/if}}</small>
            {{#if pool.isMight}}<button type="button" class="character-hud-rally cypherv2-primary-action" data-action="rally" {{#unless pool.canRally}}disabled aria-disabled="true"{{/unless}}>{{localize "CYPHERV2.Actions.Rally"}}</button>{{/if}}
          </div>
        </article>
      {{/each}}
    </section>

    <div class="character-hud-lower">
      <article class="character-hud-card character-hud-wounds {{#if header.wounds.dead}}is-dead{{/if}}">
        <div class="character-hud-card-heading">
          {{#if editable}}<button type="button" class="character-hud-card-title cypherv2-primary-action" data-action="applyWound">{{localize "CYPHERV2.Character.Wounds"}}</button>{{else}}<strong class="character-hud-card-title">{{localize "CYPHERV2.Character.Wounds"}}</strong>{{/if}}
          {{#if header.wounds.hindrance}}<span class="character-hud-hindrance" title="{{localize 'CYPHERV2.Wounds.Hindrance'}}">{{header.wounds.hindranceModifier}}</span>{{/if}}
        </div>
        <div class="character-hud-wound-columns {{#if header.shield}}has-shield{{/if}}">
          <span></span><small>{{localize "CYPHERV2.Hud.Character"}}</small>
          {{#if header.shield}}<button type="button" class="character-hud-shield-name cypherv2-primary-action" data-action="editCombatItem" data-item-id="{{header.shield.id}}">{{header.shield.name}}</button>{{/if}}
        </div>
        {{#each header.wounds.rows as |row|}}
          <div class="character-hud-wound-row {{#if ../header.shield}}has-shield{{/if}}">
            <small>{{row.character.shortLabel}}</small>
            <span class="character-hud-pips" aria-label="{{row.character.tooltip}}">{{#each row.character.pips as |pip|}}{{#if @root.editable}}<button type="button" class="character-hud-pip is-character is-editable {{#if pip.filled}}is-filled{{/if}}" data-action="setCharacterWoundCount" data-track="character" data-severity="{{row.character.severity}}" data-count="{{pip.targetCount}}" title="{{pip.tooltip}}" aria-label="{{pip.tooltip}}" aria-pressed="{{pip.filled}}"></button>{{else}}<i class="character-hud-pip is-character {{#if pip.filled}}is-filled{{/if}}"></i>{{/if}}{{/each}}</span>
            {{#if row.shield}}<span class="character-hud-pips" aria-label="{{row.shield.tooltip}}">{{#each row.shield.pips as |pip|}}{{#if @root.editable}}<button type="button" class="character-hud-pip is-shield is-editable {{#if pip.filled}}is-filled{{/if}}" data-action="setShieldWoundCount" data-track="shield" data-shield-id="{{row.shield.itemId}}" data-severity="{{row.shield.severity}}" data-count="{{pip.targetCount}}" title="{{pip.tooltip}}" aria-label="{{pip.tooltip}}" aria-pressed="{{pip.filled}}"></button>{{else}}<i class="character-hud-pip is-shield {{#if pip.filled}}is-filled{{/if}}"></i>{{/if}}{{/each}}</span>{{/if}}
          </div>
        {{/each}}
        <div class="character-hud-wound-status">
          {{#if header.wounds.dead}}<strong class="character-hud-danger">{{localize "CYPHERV2.Wounds.Dead"}}</strong>{{/if}}
          {{#if header.shield.broken}}<strong class="character-hud-danger">{{header.shield.name}} — {{localize "CYPHERV2.Shield.Broken"}}</strong>{{/if}}
        </div>
      </article>

      <article class="character-hud-card character-hud-recovery">
        <div class="character-hud-card-heading character-hud-recovery-heading">
          <strong class="character-hud-card-title">{{localize "CYPHERV2.Character.Recovery"}}</strong>
          <small class="character-hud-recovery-formula">{{header.recoveryFormulaLabel}}</small>
          {{#if header.canResetRecoveries}}<button type="button" class="cypherv2-icon-action" data-action="resetRecoveries" title="{{localize 'CYPHERV2.Hud.ResetRecoveries'}}" aria-label="{{localize 'CYPHERV2.Hud.ResetRecoveries'}}"><i class="fa-solid fa-rotate-right"></i></button>{{/if}}
        </div>
        <div class="character-hud-recovery-buttons">
          {{#each header.recoveries as |recovery|}}<button type="button" data-action="recoveryType" data-recovery-type="{{recovery.type}}" title="{{recovery.label}}" {{#if recovery.used}}disabled aria-disabled="true"{{/if}}>{{localize recovery.shortLabel}}</button>{{/each}}
        </div>
      </article>

      <section class="character-hud-currency character-hud-stat-stack" aria-label="{{localize 'CYPHERV2.Hud.Currency'}}">
          <label class="character-hud-stat-box"><small>{{localize "CYPHERV2.Hud.ResourcePointsShort"}}</small>{{#if editable}}<input class="character-hud-stat-value" name="system.resourcePoints" type="number" data-dtype="Number" value="{{header.stats.resourcePoints}}" min="0" step="1" inputmode="numeric">{{else}}<strong class="character-hud-stat-value">{{header.stats.resourcePoints}}</strong>{{/if}}</label>
          <label class="character-hud-stat-box"><small>{{localize "CYPHERV2.Character.XP"}}</small>{{#if editable}}<input class="character-hud-stat-value" name="system.xp" type="number" data-dtype="Number" value="{{header.stats.xp}}" min="0" step="1" inputmode="numeric">{{else}}<strong class="character-hud-stat-value">{{header.stats.xp}}</strong>{{/if}}</label>
      </section>
    </div>
  </header>

  <nav class="sheet-tabs tabs" data-group="primary">
    {{#each tabs as |tab|}}
      <a class="{{tab.cssClass}}" data-action="tab" data-group="{{tab.group}}" data-tab="{{tab.id}}">
        <i class="{{tab.icon}}"></i> {{localize tab.label}}
      </a>
    {{/each}}
  </nav>

  <div class="tab {{tabs.settings.cssClass}}" data-group="primary" data-tab="settings">
    <div class="character-settings-panel">
      <section class="character-settings-section character-familiarity-settings" title="{{localize 'CYPHERV2.Settings.Character.FamiliarityHint'}}">
        <header class="character-settings-section-header"><h2>{{localize "CYPHERV2.Settings.Character.Familiarities"}}</h2></header>
        <div class="character-familiarity-family"><h3>{{localize "CYPHERV2.Combat.Weapons"}}</h3><div class="character-familiarity-buttons">{{#each familiarities.weapons as |entry|}}<button type="button" class="character-familiarity-toggle {{#if entry.effective}}is-effective{{/if}} {{#if entry.manual}}is-manual{{/if}} {{#if entry.packageGranted}}is-package-granted{{/if}}" data-action="toggleFamiliarity" data-family="weapon" data-category="{{entry.category}}" aria-pressed="{{entry.manual}}" title="{{entry.sourceHint}}" {{#unless entry.canToggle}}disabled aria-disabled="true"{{/unless}}><span>{{entry.label}}</span>{{#if entry.effective}}<i class="fa-solid fa-check" aria-hidden="true"></i>{{/if}}</button>{{/each}}</div></div>
        <div class="character-familiarity-family"><h3>{{localize "CYPHERV2.Combat.Armors"}}</h3><div class="character-familiarity-buttons">{{#each familiarities.armor as |entry|}}<button type="button" class="character-familiarity-toggle {{#if entry.effective}}is-effective{{/if}} {{#if entry.manual}}is-manual{{/if}} {{#if entry.packageGranted}}is-package-granted{{/if}}" data-action="toggleFamiliarity" data-family="armor" data-category="{{entry.category}}" aria-pressed="{{entry.manual}}" title="{{entry.sourceHint}}" {{#unless entry.canToggle}}disabled aria-disabled="true"{{/unless}}><span>{{entry.label}}</span>{{#if entry.effective}}<i class="fa-solid fa-check" aria-hidden="true"></i>{{/if}}</button>{{/each}}</div></div>
      </section>

      <section class="character-settings-section character-genre-settings" data-hud-drop="genre">
        <header class="character-settings-section-header"><h2>{{localize "CYPHERV2.Genre.Label"}}</h2></header>
        {{#if genre.attached}}
          <div class="character-genre-row">
            <i class="fa-solid fa-masks-theater" aria-hidden="true"></i>
            <button type="button" class="link-button" data-action="inspectGenre" {{#unless genre.available}}disabled{{/unless}}>{{genre.name}}</button>
            <small>{{#if genre.available}}{{localize "CYPHERV2.Genre.EffortCap.Label"}}: {{genre.totalEffortCapLabel}}{{else}}{{localize "CYPHERV2.Genre.SourceUnavailable"}}{{/if}}</small>
            {{#if editable}}<span class="character-settings-row-actions"><button type="button" class="cypherv2-icon-action" data-action="addGenre" title="{{localize 'CYPHERV2.Packages.Replace'}}" aria-label="{{localize 'CYPHERV2.Packages.Replace'}} {{genre.name}}"><i class="fa-solid fa-pen"></i></button><button type="button" class="cypherv2-icon-action" data-action="removeGenre" title="{{localize 'CYPHERV2.Genre.Remove'}}" aria-label="{{localize 'CYPHERV2.Genre.Remove'}} {{genre.name}}"><i class="fa-solid fa-xmark"></i></button></span>{{/if}}
          </div>
        {{else}}
          <div class="character-genre-empty"><span class="character-genre-dropzone"><i class="fa-solid fa-arrow-down" aria-hidden="true"></i> {{localize "CYPHERV2.Genre.DropHere"}}</span>{{#if editable}}<button type="button" class="compact-inline-action" data-action="addGenre"><i class="fa-solid fa-plus"></i> {{localize "CYPHERV2.Genre.Add"}}</button>{{/if}}</div>
        {{/if}}
      </section>

      <section class="character-settings-section character-packages">
        <header class="character-settings-section-header">
          <h2>{{localize "CYPHERV2.Settings.Character.Sources"}}</h2>
          {{#if advancement.guidance.completed}}{{#if editable}}<button type="button" class="compact-inline-action" data-action="resetProgressionGuidance">{{localize "CYPHERV2.Advancement.Guidance.Reset"}}</button>{{/if}}{{/if}}
        </header>
        <div class="character-source-list">
          <div class="character-source-row"><strong>{{localize "CYPHERV2.Packages.Types"}}</strong><div class="character-source-values">{{#each typeItems as |package|}}<span class="character-source-item"><button type="button" class="link-button" data-action="inspectPackage" data-item-id="{{package.id}}">{{package.name}}</button>{{#if ../editable}}<button type="button" class="cypherv2-icon-action" data-action="removePackage" data-item-id="{{package.id}}" title="{{localize 'CYPHERV2.Actions.Remove'}}" aria-label="{{localize 'CYPHERV2.Actions.Remove'}} {{package.name}}"><i class="fa-solid fa-xmark"></i></button>{{/if}}</span>{{else}}<span class="empty-list">{{localize "CYPHERV2.Common.None"}}</span>{{/each}}</div>{{#if editable}}<button type="button" class="compact-inline-action character-source-add" data-action="addType"><i class="fa-solid fa-plus"></i> {{localize "CYPHERV2.Actions.Add"}}</button>{{/if}}</div>
          <div class="character-source-row"><strong>{{localize "CYPHERV2.Packages.PrimaryDescriptor"}}</strong><div class="character-source-values">{{#each primaryDescriptorItems as |package|}}<span class="character-source-item"><button type="button" class="link-button" data-action="inspectPackage" data-item-id="{{package.id}}">{{package.name}}</button>{{#if ../editable}}<button type="button" class="cypherv2-icon-action" data-action="removePackage" data-item-id="{{package.id}}" title="{{localize 'CYPHERV2.Actions.Remove'}}" aria-label="{{localize 'CYPHERV2.Actions.Remove'}} {{package.name}}"><i class="fa-solid fa-xmark"></i></button>{{/if}}</span>{{else}}<span class="empty-list">{{localize "CYPHERV2.Common.None"}}</span>{{/each}}</div>{{#if editable}}<button type="button" class="compact-inline-action character-source-add" data-action="addDescriptor"><i class="fa-solid fa-plus"></i> {{localize "CYPHERV2.Actions.Add"}}</button>{{/if}}</div>
          <div class="character-source-row"><strong>{{localize "CYPHERV2.Packages.Species"}}</strong><div class="character-source-values">{{#each speciesItems as |package|}}<span class="character-source-item"><button type="button" class="link-button" data-action="inspectPackage" data-item-id="{{package.id}}">{{package.name}}</button>{{#if ../editable}}<button type="button" class="cypherv2-icon-action" data-action="removePackage" data-item-id="{{package.id}}" title="{{localize 'CYPHERV2.Actions.Remove'}}" aria-label="{{localize 'CYPHERV2.Actions.Remove'}} {{package.name}}"><i class="fa-solid fa-xmark"></i></button>{{/if}}</span>{{else}}<span class="empty-list">{{localize "CYPHERV2.Common.None"}}</span>{{/each}}</div>{{#if editable}}<button type="button" class="compact-inline-action character-source-add" data-action="addSpecies"><i class="fa-solid fa-plus"></i> {{localize "CYPHERV2.Actions.Add"}}</button>{{/if}}</div>
          <div class="character-source-row"><strong>{{localize "CYPHERV2.Packages.AdditionalDescriptors"}}</strong><div class="character-source-values">{{#each additionalDescriptorItems as |package|}}<span class="character-source-item"><button type="button" class="link-button" data-action="inspectPackage" data-item-id="{{package.id}}">{{package.name}}</button>{{#if ../editable}}<button type="button" class="cypherv2-icon-action" data-action="removePackage" data-item-id="{{package.id}}" title="{{localize 'CYPHERV2.Actions.Remove'}}" aria-label="{{localize 'CYPHERV2.Actions.Remove'}} {{package.name}}"><i class="fa-solid fa-xmark"></i></button>{{/if}}</span>{{else}}<span class="empty-list">{{localize "CYPHERV2.Common.None"}}</span>{{/each}}</div>{{#if editable}}<button type="button" class="compact-inline-action character-source-add" data-action="addDescriptor"><i class="fa-solid fa-plus"></i> {{localize "CYPHERV2.Actions.Add"}}</button>{{/if}}</div>
          <div class="character-source-row"><strong>{{localize "CYPHERV2.Packages.SpeciesDescriptors"}}</strong><div class="character-source-values">{{#each speciesDescriptorItems as |package|}}<span class="character-source-item"><button type="button" class="link-button" data-action="inspectPackage" data-item-id="{{package.id}}">{{package.name}}</button>{{#if ../editable}}<button type="button" class="cypherv2-icon-action" data-action="removePackage" data-item-id="{{package.id}}" title="{{localize 'CYPHERV2.Actions.Remove'}}" aria-label="{{localize 'CYPHERV2.Actions.Remove'}} {{package.name}}"><i class="fa-solid fa-xmark"></i></button>{{/if}}</span>{{else}}<span class="empty-list">{{localize "CYPHERV2.Common.None"}}</span>{{/each}}</div></div>
        </div>
        <details class="character-granted-disclosure">
          <summary>{{localize "CYPHERV2.Settings.Character.GrantedProvenance"}}</summary>
          {{#if packageGrantedItems.length}}<ul>{{#each packageGrantedItems as |item|}}<li><button type="button" class="link-button" data-action="inspectGrantedItem" data-item-id="{{item.id}}">{{item.name}}</button><small>{{item.type}} · {{item.sourceName}} · {{item.status}}{{#if item.replacementLabel}} · {{item.replacementLabel}}{{/if}}</small></li>{{/each}}</ul>{{else}}<p class="empty-list">{{localize "CYPHERV2.Common.None"}}</p>{{/if}}
        </details>
      </section>

      <details class="character-settings-section character-settings-disclosure character-base-values" data-persistent-disclosure="base-values">
        <summary>{{localize "CYPHERV2.Settings.Character.BaseValues"}}</summary>
        <div class="character-base-values-grid">
          <article class="character-base-pool"><header><h3>{{localize "CYPHERV2.Pools.Might"}}</h3><small>{{system.stats.might.value}} / {{system.derived.pools.might.max}} · {{localize "CYPHERV2.Pools.Edge"}} {{system.derived.pools.might.edge}}</small></header><div class="character-base-fields"><label><span>{{localize "CYPHERV2.Pools.BaseMax"}}</span><input name="system.stats.might.baseMax" type="number" data-dtype="Number" value="{{system.stats.might.baseMax}}" min="1"></label><label><span>{{localize "CYPHERV2.Pools.BaseEdge"}}</span><input name="system.stats.might.baseEdge" type="number" data-dtype="Number" value="{{system.stats.might.baseEdge}}"></label></div><details class="derived-breakdown"><summary>{{localize "CYPHERV2.Packages.Breakdown"}}</summary><ul>{{#each system.derived.pools.might.maxContributions as |entry|}}<li>{{entry.label}}: +{{entry.value}}</li>{{/each}}{{#each system.derived.pools.might.edgeContributions as |entry|}}<li>{{entry.label}} (Edge): +{{entry.value}}</li>{{/each}}</ul></details></article>
          <article class="character-base-pool"><header><h3>{{localize "CYPHERV2.Pools.Speed"}}</h3><small>{{system.stats.speed.value}} / {{system.derived.pools.speed.max}} · {{localize "CYPHERV2.Pools.Edge"}} {{system.derived.pools.speed.edge}}</small></header><div class="character-base-fields"><label><span>{{localize "CYPHERV2.Pools.BaseMax"}}</span><input name="system.stats.speed.baseMax" type="number" data-dtype="Number" value="{{system.stats.speed.baseMax}}" min="1"></label><label><span>{{localize "CYPHERV2.Pools.BaseEdge"}}</span><input name="system.stats.speed.baseEdge" type="number" data-dtype="Number" value="{{system.stats.speed.baseEdge}}"></label></div><details class="derived-breakdown"><summary>{{localize "CYPHERV2.Packages.Breakdown"}}</summary><ul>{{#each system.derived.pools.speed.maxContributions as |entry|}}<li>{{entry.label}}: +{{entry.value}}</li>{{/each}}{{#each system.derived.pools.speed.edgeContributions as |entry|}}<li>{{entry.label}} (Edge): +{{entry.value}}</li>{{/each}}</ul></details></article>
          <article class="character-base-pool"><header><h3>{{localize "CYPHERV2.Pools.Intellect"}}</h3><small>{{system.stats.intellect.value}} / {{system.derived.pools.intellect.max}} · {{localize "CYPHERV2.Pools.Edge"}} {{system.derived.pools.intellect.edge}}</small></header><div class="character-base-fields"><label><span>{{localize "CYPHERV2.Pools.BaseMax"}}</span><input name="system.stats.intellect.baseMax" type="number" data-dtype="Number" value="{{system.stats.intellect.baseMax}}" min="1"></label><label><span>{{localize "CYPHERV2.Pools.BaseEdge"}}</span><input name="system.stats.intellect.baseEdge" type="number" data-dtype="Number" value="{{system.stats.intellect.baseEdge}}"></label></div><details class="derived-breakdown"><summary>{{localize "CYPHERV2.Packages.Breakdown"}}</summary><ul>{{#each system.derived.pools.intellect.maxContributions as |entry|}}<li>{{entry.label}}: +{{entry.value}}</li>{{/each}}{{#each system.derived.pools.intellect.edgeContributions as |entry|}}<li>{{entry.label}} (Edge): +{{entry.value}}</li>{{/each}}</ul></details></article>
        </div>
      </details>

      <details class="character-settings-section character-settings-disclosure character-override-settings" data-persistent-disclosure="effective-overrides">
        <summary>{{localize "CYPHERV2.Overrides.Title"}}</summary>
        <div class="character-override-list">
          {{#each characterOverrides as |entry|}}
            <div class="character-override-row">
              <strong>{{entry.label}}</strong>
              <span><small>{{localize "CYPHERV2.Overrides.Calculated"}}</small> {{entry.calculated}}</span>
              <span><small>{{localize "CYPHERV2.Overrides.Override"}}</small> {{#if entry.hasOverride}}{{entry.override}}{{else}}{{localize "CYPHERV2.Common.None"}}{{/if}}</span>
              <span><small>{{localize "CYPHERV2.Overrides.Effective"}}</small> {{entry.effective}}</span>
