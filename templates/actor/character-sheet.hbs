    <h2>{{localize "CYPHERV2.Combat.Defense.Quick"}}</h2>
    <div class="quick-defense-bar">
      <button type="button" class="quick-defense-action cypherv2-primary-action" data-action="dodge" title="{{localize 'CYPHERV2.Combat.Defense.DodgeTooltip'}}"><i class="fa-solid fa-person-running" aria-hidden="true"></i><strong>{{localize "CYPHERV2.Combat.Defense.dodge"}}</strong><small>{{localize "CYPHERV2.Pools.Speed"}}</small></button>
      <button type="button" class="quick-defense-action cypherv2-primary-action" data-action="block" title="{{localize 'CYPHERV2.Combat.Defense.BlockTooltip'}}"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i><strong>{{localize "CYPHERV2.Combat.Defense.block"}}</strong><small>{{localize "CYPHERV2.Pools.Might"}}</small></button>
    </div>
    </section>
    <section class="inventory-section combat-tab-section">
      <section class="inventory-group" data-combat-section="attacks">
        <header class="inventory-group-header">
          <h2>{{localize "CYPHERV2.Combat.Attacks"}}</h2>
          {{#if editable}}<button type="button" class="inventory-add-action cypherv2-primary-action" data-action="createWeapon" title="{{localize 'CYPHERV2.Combat.Weapon.Create'}}" aria-label="{{localize 'CYPHERV2.Combat.Weapon.Create'}}"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>{{/if}}
        </header>
        <ol class="compact-inventory-list compact-combat-list">
        {{#each weaponItems as |weapon|}}
          <li class="compact-inventory-item compact-combat-item combat-weapon-item {{#unless weapon.canAttack}}is-unusable{{/unless}} {{#if weapon.expanded}}is-expanded{{/if}}" data-item-id="{{weapon.id}}" {{#unless weapon.canAttack}}title="{{localize 'CYPHERV2.Combat.Weapon.InsufficientAmmo'}}"{{/unless}}>
            <div class="compact-inventory-row compact-combat-row combat-weapon-row" data-action="attackWeapon" data-item-id="{{weapon.id}}" role="button" tabindex="0">
              <span class="combat-row-left"><button type="button" class="inventory-details-toggle cypherv2-icon-action" data-action="toggleCombatDetails" data-item-id="{{weapon.id}}" aria-expanded="{{weapon.expanded}}" aria-controls="combat-details-{{weapon.id}}" aria-label="{{localize 'CYPHERV2.Inventory.ToggleDetails'}}: {{weapon.name}}"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button><span class="combat-attack-identity"><button type="button" class="inventory-item-name combat-attack-name cypherv2-primary-action" data-action="attackWeapon" data-item-id="{{weapon.id}}" {{#unless weapon.canAttack}}disabled title="{{localize 'CYPHERV2.Combat.Weapon.InsufficientAmmo'}}"{{/unless}}>{{weapon.name}}</button><span class="combat-attack-category">({{weapon.category}})</span></span></span>
              <span class="combat-secondary-column" aria-hidden="true"></span>
              <span class="combat-ammo-column">{{#if weapon.ammoEnabled}}<span class="combat-ammo" title="{{localize 'CYPHERV2.Combat.Ammo'}}">{{weapon.ammoLabel}}</span><button type="button" class="cypherv2-icon-action combat-reload-action" data-action="reloadWeapon" data-item-id="{{weapon.id}}" title="{{localize 'CYPHERV2.Combat.Weapon.ReloadToMaximum'}}" aria-label="{{localize 'CYPHERV2.Combat.Weapon.ReloadToMaximum'}} {{weapon.name}}"><i class="fa-solid fa-rotate-right" aria-hidden="true"></i></button>{{/if}}</span>
              <span class="combat-depletion-column">{{#if weapon.depletionEnabled}}{{#if weapon.depleted}}<span class="combat-item-summary combat-depleted-state">{{localize "CYPHERV2.Depletion.Depleted"}}</span>{{else}}<button type="button" class="combat-depletion inventory-rollable" data-action="rollCombatDepletion" data-item-id="{{weapon.id}}" title="{{localize 'CYPHERV2.Depletion.Roll'}}">{{weapon.depletionLabel}} <i class="fa-solid fa-dice" aria-hidden="true"></i></button>{{/if}}{{/if}}</span>
              <span class="combat-item-summary combat-damage-column"><strong>{{weapon.damage}}</strong> {{localize "CYPHERV2.Combat.Damage"}}</span>
              <span class="inventory-item-actions combat-item-actions"><button type="button" class="cypherv2-icon-action" data-action="sendItemToChat" data-item-id="{{weapon.id}}" title="{{localize 'CYPHERV2.Inventory.SendToChat'}}" aria-label="{{localize 'CYPHERV2.Inventory.SendToChat'}} {{weapon.name}}"><i class="fa-solid fa-message" aria-hidden="true"></i></button><button type="button" class="cypherv2-icon-action" data-action="editCombatItem" data-item-id="{{weapon.id}}" title="{{localize 'CYPHERV2.Actions.Edit'}}" aria-label="{{localize 'CYPHERV2.Actions.Edit'}} {{weapon.name}}"><i class="fa-solid fa-pen" aria-hidden="true"></i></button>{{#if ../editable}}<button type="button" class="cypherv2-icon-action" data-action="deleteCombatItem" data-item-id="{{weapon.id}}" title="{{localize 'CYPHERV2.Actions.Delete'}}" aria-label="{{localize 'CYPHERV2.Actions.Delete'}} {{weapon.name}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>{{/if}}</span>
            </div>
            <section id="combat-details-{{weapon.id}}" class="compact-inventory-details compact-combat-details" {{#unless weapon.expanded}}hidden{{/unless}}>{{#if weapon.hasDescription}}{{{weapon.enrichedDescription}}}{{else}}<p>{{localize "CYPHERV2.Inventory.NoDescription"}}</p>{{/if}}</section>
          </li>
        {{else}}<li class="compact-inventory-empty">{{localize "CYPHERV2.Combat.Weapon.Empty"}}</li>{{/each}}
        </ol>
      </section>

      <section class="inventory-group" data-combat-section="shields">
        <header class="inventory-group-header">
          <h2>{{localize "CYPHERV2.Shield.Title"}}</h2>
          {{#if editable}}<button type="button" class="inventory-add-action cypherv2-primary-action" data-action="createShield" title="{{localize 'CYPHERV2.Shield.Create'}}" aria-label="{{localize 'CYPHERV2.Shield.Create'}}"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>{{/if}}
        </header>
        {{#if multipleShieldsEquipped}}<p class="combat-warning">{{localize "CYPHERV2.Shield.MultipleEquipped"}}</p>{{/if}}
        <ol class="compact-inventory-list compact-combat-list">
        {{#each shieldItems as |shield|}}
          <li class="compact-inventory-item compact-combat-item {{#if shield.expanded}}is-expanded{{/if}}" data-item-id="{{shield.id}}">
            <div class="compact-inventory-row compact-combat-row combat-shield-row" data-action="toggleCombatDetails" data-item-id="{{shield.id}}" role="button" tabindex="0" aria-expanded="{{shield.expanded}}" aria-controls="combat-details-{{shield.id}}">
              <span class="combat-row-left"><button type="button" class="inventory-details-toggle cypherv2-icon-action" data-action="toggleCombatDetails" data-item-id="{{shield.id}}" aria-expanded="{{shield.expanded}}" aria-controls="combat-details-{{shield.id}}" aria-label="{{localize 'CYPHERV2.Inventory.ToggleDetails'}}: {{shield.name}}"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button><button type="button" class="combat-equipped-toggle cypherv2-icon-action {{#if shield.equipped}}is-equipped{{/if}}" data-action="toggleShieldEquipped" data-item-id="{{shield.id}}" title="{{#if shield.equipped}}{{localize 'CYPHERV2.Combat.UnequipShield'}}{{else}}{{localize 'CYPHERV2.Combat.EquipShield'}}{{/if}}" aria-label="{{#if shield.equipped}}{{localize 'CYPHERV2.Combat.UnequipShield'}}{{else}}{{localize 'CYPHERV2.Combat.EquipShield'}}{{/if}} {{shield.name}}" {{#unless ../editable}}disabled{{/unless}}><i class="fa-solid fa-hand" aria-hidden="true"></i></button><span class="inventory-item-name">{{shield.name}}</span></span>
              <span class="combat-secondary-column combat-shield-wounds-column"><span class="combat-inline-shield-wounds">{{#each shield.woundTracks as |track|}}<span class="combat-inline-shield-track"><abbr title="{{track.label}}">{{track.shortLabel}}</abbr>{{#each track.pips as |pip|}}<i class="combat-inline-shield-pip {{#if pip.filled}}is-filled{{/if}}"></i>{{/each}}</span>{{/each}}</span></span>
              <span class="combat-ammo-column" aria-hidden="true"></span>
              <span class="combat-depletion-column">{{#if shield.depletionEnabled}}{{#if shield.depleted}}<span class="combat-item-summary combat-depleted-state">{{localize "CYPHERV2.Depletion.Depleted"}}</span>{{else}}<button type="button" class="combat-depletion inventory-rollable" data-action="rollCombatDepletion" data-item-id="{{shield.id}}" title="{{localize 'CYPHERV2.Depletion.Roll'}}">{{shield.depletionLabel}} <i class="fa-solid fa-dice" aria-hidden="true"></i></button>{{/if}}{{/if}}</span>
              <span class="combat-status-column">{{#if shield.equipped}}<span class="combat-item-summary combat-equipped-state">{{localize "CYPHERV2.Combat.Equipped"}}</span>{{#if shield.broken}}<span class="combat-status-separator">·</span>{{/if}}{{/if}}{{#if shield.broken}}<span class="combat-item-summary combat-shield-state is-broken">{{localize "CYPHERV2.Shield.Broken"}}</span>{{/if}}</span>
              <span class="inventory-item-actions combat-item-actions"><button type="button" class="cypherv2-icon-action" data-action="sendItemToChat" data-item-id="{{shield.id}}" title="{{localize 'CYPHERV2.Inventory.SendToChat'}}" aria-label="{{localize 'CYPHERV2.Inventory.SendToChat'}} {{shield.name}}"><i class="fa-solid fa-message" aria-hidden="true"></i></button><button type="button" class="cypherv2-icon-action" data-action="editCombatItem" data-item-id="{{shield.id}}" title="{{localize 'CYPHERV2.Actions.Edit'}}" aria-label="{{localize 'CYPHERV2.Actions.Edit'}} {{shield.name}}"><i class="fa-solid fa-pen" aria-hidden="true"></i></button>{{#if ../editable}}<button type="button" class="cypherv2-icon-action" data-action="deleteCombatItem" data-item-id="{{shield.id}}" title="{{localize 'CYPHERV2.Actions.Delete'}}" aria-label="{{localize 'CYPHERV2.Actions.Delete'}} {{shield.name}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>{{/if}}</span>
            </div>
            <section id="combat-details-{{shield.id}}" class="compact-inventory-details compact-combat-details" {{#unless shield.expanded}}hidden{{/unless}}>
              {{#if shield.hasDescription}}{{{shield.enrichedDescription}}}{{else}}<p>{{localize "CYPHERV2.Inventory.NoDescription"}}</p>{{/if}}
              <p class="combat-shield-wounds">{{localize "CYPHERV2.Wounds.Minor"}} {{shield.minor}}/{{shield.capacities.minor}} · {{localize "CYPHERV2.Wounds.Moderate"}} {{shield.moderate}}/{{shield.capacities.moderate}} · {{localize "CYPHERV2.Wounds.Major"}} {{shield.major}}/{{shield.capacities.major}}</p>
            </section>
          </li>
        {{else}}<li class="compact-inventory-empty">{{localize "CYPHERV2.Shield.Empty"}}</li>{{/each}}
        </ol>
      </section>

      <section class="inventory-group" data-combat-section="armor">
        <header class="inventory-group-header">
          <h2>{{localize "CYPHERV2.Combat.Armors"}}</h2>
          <span class="combat-armor-total">{{localize "CYPHERV2.Combat.Armor.Total"}} <strong>{{system.derived.combat.armor.blockEase}}</strong></span>
          {{#if editable}}<button type="button" class="inventory-add-action cypherv2-primary-action" data-action="createArmor" title="{{localize 'CYPHERV2.Combat.Armor.Create'}}" aria-label="{{localize 'CYPHERV2.Combat.Armor.Create'}}"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>{{/if}}
        </header>
        <ol class="compact-inventory-list compact-combat-list">
        {{#each armorItems as |armor|}}
          <li class="compact-inventory-item compact-combat-item {{#if armor.expanded}}is-expanded{{/if}}" data-item-id="{{armor.id}}">
            <div class="compact-inventory-row compact-combat-row combat-armor-row" data-action="toggleCombatDetails" data-item-id="{{armor.id}}" role="button" tabindex="0" aria-expanded="{{armor.expanded}}" aria-controls="combat-details-{{armor.id}}">
              <span class="combat-row-left"><button type="button" class="inventory-details-toggle cypherv2-icon-action" data-action="toggleCombatDetails" data-item-id="{{armor.id}}" aria-expanded="{{armor.expanded}}" aria-controls="combat-details-{{armor.id}}" aria-label="{{localize 'CYPHERV2.Inventory.ToggleDetails'}}: {{armor.name}}"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button><button type="button" class="combat-equipped-toggle cypherv2-icon-action {{#if armor.equipped}}is-equipped{{/if}}" data-action="toggleArmorEquipped" data-item-id="{{armor.id}}" title="{{#if armor.equipped}}{{localize 'CYPHERV2.Combat.UnequipArmor'}}{{else}}{{localize 'CYPHERV2.Combat.EquipArmor'}}{{/if}}" aria-label="{{#if armor.equipped}}{{localize 'CYPHERV2.Combat.UnequipArmor'}}{{else}}{{localize 'CYPHERV2.Combat.EquipArmor'}}{{/if}} {{armor.name}}" {{#unless ../editable}}disabled{{/unless}}><i class="fa-solid fa-hand" aria-hidden="true"></i></button><span class="combat-attack-identity"><span class="inventory-item-name">{{armor.name}}</span><span class="combat-attack-category">({{armor.category}})</span></span></span>
              <span class="combat-secondary-column combat-familiarity-column">{{#unless armor.freelyUsed}}<span class="combat-familiarity-warning" title="{{localize 'CYPHERV2.Combat.Armor.UnfamiliarTooltip'}}">{{localize "CYPHERV2.Combat.Armor.UnfamiliarLabel"}}</span>{{/unless}}</span>
              <span class="combat-ammo-column" aria-hidden="true"></span>
              <span class="combat-depletion-column">{{#if armor.depletionEnabled}}{{#if armor.depleted}}<span class="combat-item-summary combat-depleted-state">{{localize "CYPHERV2.Depletion.Depleted"}}</span>{{else}}<button type="button" class="combat-depletion inventory-rollable" data-action="rollCombatDepletion" data-item-id="{{armor.id}}" title="{{localize 'CYPHERV2.Depletion.Roll'}}">{{armor.depletionLabel}} <i class="fa-solid fa-dice" aria-hidden="true"></i></button>{{/if}}{{/if}}</span>
              <span class="combat-status-column">{{#if armor.equipped}}<span class="combat-item-summary combat-equipped-state">{{localize "CYPHERV2.Combat.Equipped"}}</span>{{/if}}</span>
              <span class="inventory-item-actions combat-item-actions"><button type="button" class="cypherv2-icon-action" data-action="sendItemToChat" data-item-id="{{armor.id}}" title="{{localize 'CYPHERV2.Inventory.SendToChat'}}" aria-label="{{localize 'CYPHERV2.Inventory.SendToChat'}} {{armor.name}}"><i class="fa-solid fa-message" aria-hidden="true"></i></button><button type="button" class="cypherv2-icon-action" data-action="editCombatItem" data-item-id="{{armor.id}}" title="{{localize 'CYPHERV2.Actions.Edit'}}" aria-label="{{localize 'CYPHERV2.Actions.Edit'}} {{armor.name}}"><i class="fa-solid fa-pen" aria-hidden="true"></i></button>{{#if ../editable}}<button type="button" class="cypherv2-icon-action" data-action="deleteCombatItem" data-item-id="{{armor.id}}" title="{{localize 'CYPHERV2.Actions.Delete'}}" aria-label="{{localize 'CYPHERV2.Actions.Delete'}} {{armor.name}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>{{/if}}</span>
            </div>
            <section id="combat-details-{{armor.id}}" class="compact-inventory-details compact-combat-details" {{#unless armor.expanded}}hidden{{/unless}}>{{#if armor.hasDescription}}{{{armor.enrichedDescription}}}{{else}}<p>{{localize "CYPHERV2.Inventory.NoDescription"}}</p>{{/if}}</section>
          </li>
        {{else}}<li class="compact-inventory-empty">{{localize "CYPHERV2.Combat.Armor.Empty"}}</li>{{/each}}
        </ol>
      </section>
    </section>
  </div>

  <div class="tab {{tabs.notes.cssClass}} character-notes-tab" data-group="primary" data-tab="notes">
    <section class="character-notes-layout">
      <div class="stacked-field cypherv2-rich-description character-notes-editor">
        {{formInput systemFields.notes name="system.notes" value=source.system.notes enriched=enriched.notes elementType="prose-mirror" toggled=true disabled=(not editable) documentUUID=actor.uuid}}
      </div>
    </section>
  </div>

  <div class="tab {{tabs.advancement.cssClass}}" data-group="primary" data-tab="advancement">
    <section class="character-progression-page">
      {{#unless advancement.guidance.completed}}
        <aside class="progression-guidance-banner">
          <div><strong>{{advancement.guidance.title}}</strong><span>{{advancement.guidance.reminder}}</span></div>
          {{#if editable}}<button type="button" class="compact-inline-action" data-action="completeProgressionGuidance">{{localize "CYPHERV2.Advancement.Guidance.Done"}}</button>{{/if}}
        </aside>
      {{/unless}}

      <section class="advancement-section progression-section">
        <header class="progression-section-header">
          <h2>{{localize "CYPHERV2.Advancement.CompactTitle"}}</h2>
          <p class="derived-summary">{{localize "CYPHERV2.Character.Tier"}} {{header.stats.tier}} · {{advancement.purchasedCount}} / {{advancement.policy.purchasesPerTier}}</p>
          {{#if advancement.canAdvanceTier}}<button type="button" class="compact-inline-action" data-action="advanceTier">{{localize "CYPHERV2.Advancement.AdvanceTier"}}</button>{{/if}}
        </header>

        <ol class="advancement-options compact-advancement-options">
          {{#each advancement.options as |option|}}
            <li class="{{#if option.purchased}}purchased{{/if}}">
              <button type="button" class="advancement-compact-button" data-action="purchaseAdvancement" data-kind="{{option.kind}}" title="{{localize option.label}}" {{#if option.purchased}}disabled{{else}}{{#unless option.available}}disabled{{/unless}}{{/if}}>
                <i class="fa-{{#if option.purchased}}solid fa-check{{else}}regular fa-square{{/if}}" aria-hidden="true"></i>
                <strong>{{localize option.shortLabel}}</strong><span>· {{option.xpCost}} XP</span>
              </button>
            </li>
          {{/each}}
          <li class="{{#if advancement.other.purchased}}purchased{{/if}}">
            <button type="button" class="advancement-compact-button" data-action="purchaseAdvancement" data-kind="other" title="{{localize advancement.other.label}}" {{#if advancement.other.purchased}}disabled{{else}}{{#unless advancement.other.available}}disabled{{/unless}}{{/if}}>
              <i class="fa-{{#if advancement.other.purchased}}solid fa-check{{else}}regular fa-square{{/if}}" aria-hidden="true"></i>
              <strong>{{localize advancement.other.shortLabel}}</strong><span>· {{advancement.other.xpCost}} XP</span>
            </button>
          </li>
        </ol>

        {{#if advancement.purchases.length}}
          <details class="advancement-cycle-details">
            <summary>{{localize "CYPHERV2.Advancement.ThisCycle"}}</summary>
            <ul class="advancement-purchases">
              {{#each advancement.purchases as |purchase|}}<li>{{localize purchase.label}} · {{purchase.xpCost}} XP · +{{purchase.resourcePointsGranted}} {{localize "CYPHERV2.Character.ResourcePoints"}}</li>{{/each}}
            </ul>
          </details>
        {{/if}}
      </section>

      <section class="focus-progression-section progression-section">
        <header class="progression-section-header">
          <h2>{{localize "CYPHERV2.Focus.CompactTitle"}}</h2>
          <div class="progression-compact-actions">
            {{#if editable}}<button type="button" class="compact-inline-action" data-action="addFocus"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "CYPHERV2.Focus.Association.Add"}}</button>{{/if}}
            {{#if genre.available}}<button type="button" class="compact-inline-action" data-action="browseGenreAbilities">{{localize "CYPHERV2.Genre.AddAbilities"}}</button>{{/if}}
          </div>
        </header>
        {{#each focusTrees as |tree|}}
          <article class="focus-progression">
            <header class="focus-progression-header">
              <h3>{{tree.focusName}} <small>— {{localize tree.provenanceLabel}}</small></h3>
              {{#if ../editable}}<button type="button" class="compact-inline-action" data-action="removeFocus" data-focus-uuid="{{tree.focusUuid}}">{{localize "CYPHERV2.Focus.Association.Remove"}}</button>{{/if}}
            </header>
            {{> "systems/cypherv2/templates/focus/focus-tree.hbs" tree}}
          </article>
        {{else}}<p class="empty-list">{{localize "CYPHERV2.Focus.NoProgression"}}</p>{{/each}}
        {{#if missingFoci.length}}<aside class="focus-tree-diagnostics"><strong>{{localize "CYPHERV2.Focus.MissingFoci"}}</strong><ul>{{#each missingFoci as |uuid|}}<li>{{uuid}}</li>{{/each}}</ul></aside>{{/if}}
      </section>
    </section>
  </div>

</div>
