  <div class="tab {{tabs.abilities.cssClass}}" data-group="primary" data-tab="abilities">
    <section class="abilities-section">
      <header class="abilities-header">
        {{#if editable}}<button type="button" class="abilities-add-action cypherv2-primary-action" data-action="createAbility"><i class="fa-solid fa-plus"></i> {{localize "CYPHERV2.Ability.Add"}}</button>{{/if}}
      </header>
      <ol class="compact-ability-list">
        {{#each abilityItems as |ability|}}
          <li class="compact-ability {{#if ability.expanded}}is-expanded{{/if}} {{#if ability.archived}}is-archived{{/if}} {{#if ability.startsArchivedGroup}}starts-archived-group{{/if}}" data-item-id="{{ability.id}}">
            <div class="compact-ability-row">
              <button type="button" class="ability-details-toggle cypherv2-icon-action" data-action="toggleAbilityDetails" data-item-id="{{ability.id}}" aria-expanded="{{ability.expanded}}" aria-controls="ability-details-{{ability.id}}" aria-label="{{localize 'CYPHERV2.Ability.ToggleDetails'}}: {{ability.name}}"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
              <button type="button" class="ability-reference cypherv2-primary-action" data-action="toggleAbilityDetails" data-item-id="{{ability.id}}" aria-expanded="{{ability.expanded}}" aria-controls="ability-details-{{ability.id}}"><span class="ability-name">{{ability.name}}</span>{{#if ability.costLabel}} <span class="ability-cost">({{ability.costLabel}})</span>{{/if}}</button>
              <span class="compact-ability-actions">
                <button type="button" class="cypherv2-icon-action" data-action="sendItemToChat" data-item-id="{{ability.id}}" title="{{localize 'CYPHERV2.Inventory.SendToChat'}}" aria-label="{{localize 'CYPHERV2.Inventory.SendToChat'}} {{ability.name}}"><i class="fa-solid fa-message" aria-hidden="true"></i></button>
                {{#if ability.canPay}}<button type="button" class="cypherv2-icon-action" data-action="payAbilityCost" data-item-id="{{ability.id}}" title="{{localize 'CYPHERV2.Ability.Payment.PayCost'}}" aria-label="{{localize 'CYPHERV2.Ability.Payment.PayCost'}} {{ability.name}}"><i class="fa-solid fa-coins" aria-hidden="true"></i></button>{{/if}}
                {{#if ../editable}}
                  {{#if ability.archived}}
                    <button type="button" class="cypherv2-icon-action ability-archive-action" data-action="toggleAbilityArchived" data-item-id="{{ability.id}}" title="{{localize 'CYPHERV2.Ability.Archive.Restore'}}" aria-label="{{localize 'CYPHERV2.Ability.Archive.Restore'}} {{ability.name}}"><i class="fa-solid fa-arrow-rotate-left" aria-hidden="true"></i></button>
                  {{else}}
                    <button type="button" class="cypherv2-icon-action ability-archive-action" data-action="toggleAbilityArchived" data-item-id="{{ability.id}}" title="{{localize 'CYPHERV2.Ability.Archive.Archive'}}" aria-label="{{localize 'CYPHERV2.Ability.Archive.Archive'}} {{ability.name}}"><i class="fa-solid fa-box-archive" aria-hidden="true"></i></button>
                  {{/if}}
                {{/if}}
                {{#if ../editable}}<button type="button" class="cypherv2-icon-action" data-action="inspectAbility" data-item-id="{{ability.id}}" title="{{localize 'CYPHERV2.Actions.Edit'}}" aria-label="{{localize 'CYPHERV2.Actions.Edit'}} {{ability.name}}"><i class="fa-solid fa-pen" aria-hidden="true"></i></button>{{/if}}
                {{#if ability.canDelete}}<button type="button" class="cypherv2-icon-action" data-action="deleteAbility" data-item-id="{{ability.id}}" title="{{localize 'CYPHERV2.Actions.Delete'}}" aria-label="{{localize 'CYPHERV2.Actions.Delete'}} {{ability.name}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>{{/if}}
              </span>
            </div>
            <section id="ability-details-{{ability.id}}" class="compact-ability-details" aria-label="{{localize 'CYPHERV2.Ability.Details'}} {{ability.name}}" {{#unless ability.expanded}}hidden{{/unless}}>
              {{#if ability.hasDescription}}
                <div class="ability-description">{{{ability.enrichedDescription}}}</div>
              {{else}}
                <p class="ability-no-description">{{localize "CYPHERV2.Ability.NoDescription"}}</p>
              {{/if}}
            </section>
          </li>
        {{else}}
          <li class="compact-ability-empty">{{localize "CYPHERV2.Ability.Empty"}}</li>
        {{/each}}
      </ol>
    </section>
  </div>

  <div class="tab {{tabs.inventory.cssClass}}" data-group="primary" data-tab="inventory">
