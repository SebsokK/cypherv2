                <span class="inventory-item-actions"><button type="button" class="cypherv2-icon-action" data-action="sendItemToChat" data-item-id="{{item.id}}" title="{{localize 'CYPHERV2.Inventory.SendToChat'}}" aria-label="{{localize 'CYPHERV2.Inventory.SendToChat'}} {{item.name}}"><i class="fa-solid fa-message" aria-hidden="true"></i></button><button type="button" class="cypherv2-icon-action" data-action="openInventoryItem" data-item-id="{{item.id}}" title="{{localize 'CYPHERV2.Actions.Edit'}}" aria-label="{{localize 'CYPHERV2.Actions.Edit'}} {{item.name}}"><i class="fa-solid fa-pen" aria-hidden="true"></i></button>{{#if ../editable}}<button type="button" class="cypherv2-icon-action" data-action="deleteInventoryItem" data-item-id="{{item.id}}" title="{{localize 'CYPHERV2.Actions.Delete'}}" aria-label="{{localize 'CYPHERV2.Actions.Delete'}} {{item.name}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>{{/if}}</span>
              </div>
              <section id="inventory-details-{{item.id}}" class="compact-inventory-details" {{#unless item.expanded}}hidden{{/unless}}>{{#if item.hasDescription}}{{{item.enrichedDescription}}}{{else}}<p>{{localize "CYPHERV2.Inventory.NoDescription"}}</p>{{/if}}</section>
            </li>
          {{else}}<li class="compact-inventory-empty">{{localize "CYPHERV2.Inventory.Empty.Equipment"}}</li>{{/each}}
        </ol>
