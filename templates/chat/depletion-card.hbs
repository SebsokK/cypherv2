<article class="cypherv2 cypherv2-chat-card cypherv2-depletion-card"{{#if chatCardStyle}} style="{{chatCardStyle}}"{{/if}}>
  {{#if actorImage}}<img class="cypherv2-chat-watermark" src="{{actorImage}}" alt="" aria-hidden="true">{{/if}}
  <header><h3>{{localize "CYPHERV2.Depletion.Roll"}} — {{itemName}}</h3></header>
  <p>{{formula}}: <strong>{{total}}</strong></p>
  <p class="roll-outcome {{#if depleted}}failure{{else}}success{{/if}}"><strong>{{outcome}}</strong></p>
</article>
