<article class="cypherv2 cypherv2-chat-card cypherv2-roll-card cypherv2-item-card"{{#if chatCardStyle}} style="{{chatCardStyle}}"{{/if}}>
  {{#if actorImage}}<img class="cypherv2-chat-watermark" src="{{actorImage}}" alt="" aria-hidden="true">{{/if}}
  <header><h3>{{itemName}}</h3><span>{{label}}</span></header>
  <p>{{formula}}: <strong>{{total}}</strong></p>
</article>
