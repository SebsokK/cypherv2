ton type="button" class="cypherv2-icon-action" data-action="refreshPackageGrant" data-grant-kind="option" data-group-id="{{../id}}" data-grant-id="{{option.id}}"><i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i></button><button type="button" class="cypherv2-icon-action compact-package-remove-action" data-action="removePackageGrant" data-grant-kind="option" data-group-id="{{../id}}" data-grant-id="{{option.id}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button></span></li>{{else}}<li class="empty-list compact-package-empty">{{localize "CYPHERV2.Packages.NoOptions"}}</li>{{/each}}</ol></article>{{else}}<p class="empty-list compact-package-empty">{{localize "CYPHERV2.Common.None"}}</p>{{/each}}</div></section>

        <section class="package-grants compact-package-section species-grant-section"><header class="compact-package-header"><h3>{{localize "CYPHERV2.Species.DescriptorGrants"}}</h3>{{#if editable}}<button type="button" class="compact-package-add-action cypherv2-icon-action" data-action="addPackageGrant" data-grant-target="descriptor"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>{{/if}}</header><ol class="compact-package-grant-list">{{#each system.descriptorGrants as |grant|}}<li class="compact-package-grant-row"><span class="compact-package-grant-identity"><strong>{{grant.snapshot.name}}</strong></span><span class="compact-package-row-actions"><button type="button" class="cypherv2-icon-action" data-action="inspectPackageGrant" data-grant-kind="descriptor" data-grant-id="{{grant.id}}"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button><button type="button" class="cypherv2-icon-action" data-action="refreshPackageGrant" data-grant-kind="descriptor" data-grant-id="{{grant.id}}"><i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i></button><button type="button" class="cypherv2-icon-action compact-package-remove-action" data-action="removePackageGrant" data-grant-kind="descriptor" data-grant-id="{{grant.id}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button></span></li>{{else}}<li class="empty-list compact-package-empty">{{localize "CYPHERV2.Common.None"}}</li>{{/each}}</ol></section>
        <section class="package-grants compact-package-section species-choice-section species-descriptor-choice-section"><header class="compact-package-header"><h3>{{localize "CYPHERV2.Species.DescriptorChoices"}}</h3>{{#if editable}}<button type="button" class="compact-package-add-action cypherv2-icon-action" data-action="addChoiceGroup" data-choice-kind="descriptor"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>{{/if}}</header><div class="compact-package-choice-groups">{{#each speciesDescriptorChoiceGroups as |group|}}<article class="package-choice-group compact-package-choice-group"><header><span class="compact-package-choice-summary"><strong>{{localize "CYPHERV2.Packages.Choose"}} {{group.choose}}</strong>{{#if group.catalogMode}}<small>{{group.catalogLabel}}</small>{{/if}}</span><span class="compact-package-row-actions">{{#unless group.catalogMode}}<button type="button" class="cypherv2-icon-action" data-action="addChoiceOption" data-choice-kind="descriptor" data-group-id="{{group.id}}"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>{{/unless}}<button type="button" class="cypherv2-icon-action compact-package-remove-action" data-action="removePackageGrant" data-grant-kind="descriptorGroup" data-grant-id="{{group.id}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button></span></header>{{#unless group.catalogMode}}<ol class="compact-package-grant-list compact-package-choice-list">{{#each group.options as |option|}}<li class="compact-package-grant-row"><span class="compact-package-grant-identity"><strong>{{option.snapshot.name}}</strong></span><span class="compact-package-row-actions"><button type="button" class="cypherv2-icon-action" data-action="inspectPackageGrant" data-grant-kind="descriptorOption" data-group-id="{{../id}}" data-grant-id="{{option.id}}"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button><button type="button" class="cypherv2-icon-action" data-action="refreshPackageGrant" data-grant-kind="descriptorOption" data-group-id="{{../id}}" data-grant-id="{{option.id}}"><i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i></button><button type="button" class="cypherv2-icon-action compact-package-remove-action" data-action="removePackageGrant" data-grant-kind="descriptorOption" data-group-id="{{../id}}" data-grant-id="{{option.id}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button></span></li>{{else}}<li class="empty-list compact-package-empty">{{localize "CYPHERV2.Packages.NoOptions"}}</li>{{/each}}</ol>{{/unless}}</article>{{else}}<p class="empty-list compact-package-empty">{{localize "CYPHERV2.Common.None"}}</p>{{/each}}</div></section>
      </section>
    {{/if}}
    {{#if isFocus}}
      <section class="focus-item-information">
        <div class="stacked-field cypherv2-rich-description">
          <span>{{localize "CYPHERV2.Common.Description"}}</span>
          {{formInput systemFields.description name="system.description" value=source.system.description enriched=enriched.description elementType="prose-mirror" toggled=true disabled=(not editable) documentUUID=item.uuid}}
        </div>
      </section>
      <section class="focus-item-tree{{#if focusTreeEditing}} editing{{/if}}">
        <header class="focus-tree-editor-header">
          <div>
            <h2>{{localize "CYPHERV2.Focus.Tree"}}</h2>
            <small>{{#if focusTreeEditing}}{{localize "CYPHERV2.Focus.Editor.WorkingCopy"}}{{else}}{{localize "CYPHERV2.Focus.Editor.ReadOnly"}}{{/if}}</small>
          </div>
          <div class="focus-tree-editor-actions">
            {{#if canEditFocusTree}}
              <button type="button" data-action="editFocusTree"><i class="fa-solid fa-diagram-project"></i> {{localize "CYPHERV2.Focus.Editor.EditTree"}}</button>
            {{/if}}
            {{#if focusTreeEditing}}
              <button type="button" data-action="saveFocusTree"><i class="fa-solid fa-floppy-disk"></i> {{localize "CYPHERV2.Focus.Editor.SaveTree"}}</button>
              <button type="button" class="danger" data-action="clearFocusConnections" {{#unless focusEditor.connections.length}}disabled{{/unless}}><i class="fa-solid fa-eraser"></i> {{localize "CYPHERV2.Focus.Editor.ClearConnections"}}</button>
              <button type="button" data-action="cancelFocusTree"><i class="fa-solid fa-xmark"></i> {{localize "CYPHERV2.Focus.Editor.CancelEditing"}}</button>
            {{/if}}
          </div>
        </header>
        {{#if focusTreeEditing}}
          <div class="focus-tree-editor-toolbar">
            <button type="button" data-action="addFocusAbility"><i class="fa-solid fa-plus"></i> {{localize "CYPHERV2.Focus.Editor.AddAbility"}}</button>
            <span class="focus-tree-editor-dropzone"><i class="fa-solid fa-arrow-down"></i> {{localize "CYPHERV2.Focus.Editor.DropAbility"}}</span>
            {{#if focusEditor.dirty}}<strong>{{localize "CYPHERV2.Focus.Editor.Unsaved"}}</strong>{{/if}}
          </div>
          {{#if focusEditor.selectedNode}}
            <section class="focus-tree-node-editor" tabindex="-1">
              <header>
                <div>
                  <strong class="focus-tree-selected-label">{{localize "CYPHERV2.Focus.Editor.SelectedNode"}}</strong>
                  <h3>{{focusEditor.selectedNode.abilitySnapshot.name}}</h3>
                  <small>{{localize "CYPHERV2.Focus.Tier"}} {{focusEditor.selectedNode.tier}} · {{focusEditor.selectedNode.id}}</small>
                </div>
                <button type="button" data-action="openFocusNode" data-node-id="{{focusEditor.selectedNode.id}}">{{localize "CYPHERV2.Focus.Editor.InspectAbility"}}</button>
              </header>
              <div class="focus-node-editor-row">
                <strong>{{localize "CYPHERV2.Focus.Editor.Move"}}</strong>
                <button type="button" data-action="moveFocusNode" data-node-id="{{focusEditor.selectedNode.id}}" data-direction="left" aria-label="{{localize 'CYPHERV2.Focus.Editor.MoveLeft'}}"><i class="fa-solid fa-arrow-left"></i></button>
                <button type="button" data-action="moveFocusNode" data-node-id="{{focusEditor.selectedNode.id}}" data-direction="right" aria-label="{{localize 'CYPHERV2.Focus.Editor.MoveRight'}}"><i class="fa-solid fa-arrow-right"></i></button>
              </div>
              <div class="focus-node-editor-row">
                <strong>{{localize "CYPHERV2.Focus.Tier"}}</strong>
                {{#each focusEditor.tierOptions as |tier|}}
                  <button type="button" data-action="setFocusNodeTier" data-node-id="{{../focusEditor.selectedNode.id}}" data-tier="{{tier}}">{{tier}}</button>
                {{/each}}
              </div>
              <div class="focus-node-editor-row focus-node-editor-commands">
                <button type="button" data-action="startFocusConnection" data-node-id="{{focusEditor.selectedNode.id}}"><i class="fa-solid fa-arrow-right-long"></i> {{localize "CYPHERV2.Focus.Editor.Connect"}}</button>
                <button type="button" data-action="refreshFocusSnapshot" data-node-id="{{focusEditor.selectedNode.id}}"><i class="fa-solid fa-arrows-rotate"></i> {{localize "CYPHERV2.Focus.Editor.RefreshSnapshot"}}</button>
                <button type="button" class="danger" data-action="deleteFocusNode" data-node-id="{{focusEditor.selectedNode.id}}"><i class="fa-solid fa-trash"></i> {{localize "CYPHERV2.Focus.Editor.DeleteNode"}}</button>
              </div>
              {{#if focusEditor.connecting}}
                <div class="focus-tree-connection-prompt">
                  <span>{{localize "CYPHERV2.Focus.Editor.ConnectFrom"}} <strong>{{focusEditor.connectionSourceName}}</strong> — {{localize "CYPHERV2.Focus.Editor.ChooseDestination"}}</span>
                  <button type="button" data-action="cancelFocusConnection">{{localize "CYPHERV2.Actions.Cancel"}}</button>
                </div>
              {{/if}}
            </section>
          {{else}}
            <section class="focus-tree-node-editor empty">
              <p class="focus-tree-editor-hint">{{localize "CYPHERV2.Focus.Editor.SelectNode"}}</p>
            </section>
          {{/if}}
        {{/if}}
        {{#each focusTrees as |tree|}}
          {{> "systems/cypherv2/templates/focus/focus-tree.hbs" tree}}
        {{/each}}
        {{#if focusTreeEditing}}
          <section class="focus-tree-connection-list">
            <h3>{{localize "CYPHERV2.Focus.Editor.Connections"}}</h3>
            {{#if focusEditor.connections.length}}
              <ul>
                {{#each focusEditor.connections as |connection|}}
                  <li>
                    <span><strong>{{connection.fromName}}</strong> → <strong>{{connection.toName}}</strong></span>
                    <button type="button" data-action="deleteFocusConnection" data-connection-id="{{connection.id}}">{{localize "CYPHERV2.Actions.Delete"}}</button>
                  </li>
                {{/each}}
              </ul>
            {{else}}
              <p>{{localize "CYPHERV2.Focus.Editor.NoConnections"}}</p>
            {{/if}}
          </section>
        {{/if}}
      </section>
      <details class="compact-technical-area focus-technical-area">
        <summary><i class="fa-solid fa-gear" aria-hidden="true"></i> {{localize "CYPHERV2.Item.AdvancedTechnical"}}</summary>
        <div class="compact-technical-grid">
          <label class="compact-mechanic-field">{{localize "CYPHERV2.Item.Slug"}} <input name="system.slug" type="text" value="{{system.slug}}"></label>
          <span>{{localize "CYPHERV2.Item.RuleElements"}}: {{system.ruleElements.length}}</span>
        </div>
      </details>
    {{/if}}
    {{#if isGenre}}
      <section class="compact-rule-layout genre-item-sheet-layout">
        <div class="stacked-field cypherv2-rich-description compact-rule-description">
          <span>{{localize "CYPHERV2.Common.Description"}}</span>
          {{formInput systemFields.description name="system.description" value=source.system.description enriched=enriched.description elementType="prose-mirror" toggled=true disabled=(not editable) documentUUID=item.uuid}}
        </div>
        <section class="genre-ability-catalog compact-package-section">
          <header class="compact-package-header">
            <h3>{{localize "CYPHERV2.Genre.AbilityCatalog"}}</h3>
            {{#if editable}}<button type="button" class="compact-package-add-action cypherv2-icon-action" data-action="addGenreAbility" title="{{localize 'CYPHERV2.Genre.AddAbility'}}" aria-label="{{localize 'CYPHERV2.Genre.AddAbility'}}"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>{{/if}}
          </header>
          <small class="genre-catalog-help">{{localize "CYPHERV2.Genre.DropAbilityHint"}}</small>
          <ol class="genre-ability-list compact-package-grant-list">
            {{#each genreCatalogEntries as |entry|}}
              <li class="genre-ability-row compact-package-grant-row">
                <span class="compact-package-grant-identity"><strong>{{entry.snapshot.name}}</strong><small class="genre-entry-kind">{{entry.catalogLabel}}{{#if entry.progressionBandLabel}} · {{entry.progressionBandLabel}}{{/if}}{{#if entry.minimumSuperheroRank}} · {{localize "CYPHERV2.Genre.SuperheroRankShort"}} {{entry.minimumSuperheroRank}}+{{/if}}</small></span>
                <span class="genre-ability-controls">
                  {{#if ../editable}}<label class="genre-entry-tier">{{localize "CYPHERV2.Genre.MinimumTier"}} <input data-genre-minimum-tier data-entry-id="{{entry.id}}" type="number" min="{{../genreMinimumTierMin}}" max="{{../genreMinimumTierMax}}" step="1" value="{{entry.minimumTier}}"></label>{{else}}<small class="genre-entry-tier genre-entry-tier-readonly">{{localize "CYPHERV2.Genre.MinimumTier"}} {{entry.minimumTier}}</small>{{/if}}
                  <span class="compact-package-row-actions"><button type="button" class="cypherv2-icon-action" data-action="inspectGenreAbility" data-entry-id="{{entry.id}}" title="{{localize 'CYPHERV2.Actions.Inspect'}}" aria-label="{{localize 'CYPHERV2.Actions.Inspect'}} {{entry.snapshot.name}}"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>{{#if ../editable}}<button type="button" class="cypherv2-icon-action" data-action="refreshGenreAbility" data-entry-id="{{entry.id}}" title="{{localize 'CYPHERV2.Packages.RefreshSnapshot'}}" aria-label="{{localize 'CYPHERV2.Packages.RefreshSnapshot'}} {{entry.snapshot.name}}"><i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i></button><button type="button" class="cypherv2-icon-action compact-package-remove-action" data-action="removeGenreAbility" data-entry-id="{{entry.id}}" title="{{localize 'CYPHERV2.Actions.Remove'}}" aria-label="{{localize 'CYPHERV2.Actions.Remove'}} {{entry.snapshot.name}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>{{/if}}</span>
                </span>
              </li>
            {{else}}<li class="empty-list compact-package-empty">{{localize "CYPHERV2.Genre.NoAbilities"}}</li>{{/each}}
          </ol>
        </section>
        <section class="genre-options compact-package-section">
          <header class="compact-package-header"><h3>{{localize "CYPHERV2.Genre.Options"}}</h3></header>
          <label class="compact-mechanic-field">{{localize "CYPHERV2.Genre.TotalEffortCap"}} <select name="system.options.totalEffortCapMode">{{#each genreEffortCapOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}</select></label>
        </section>
        <details class="compact-technical-area" data-persistent-disclosure="genre-technical"><summary><i class="fa-solid fa-gear" aria-hidden="true"></i> {{localize "CYPHERV2.Item.AdvancedTechnical"}}</summary><div class="compact-technical-grid"><label class="compact-mechanic-field">{{localize "CYPHERV2.Genre.LegacyKey"}} <input name="system.legacyKey" type="text" value="{{system.legacyKey}}"></label><label class="compact-mechanic-field">{{localize "CYPHERV2.Item.Slug"}} <input name="system.slug" type="text" value="{{system.slug}}"></label><span>{{localize "CYPHERV2.Item.RuleElements"}}: {{system.ruleElements.length}}</span></div></details>
      </section>
    {{/if}}
    {{#unless isFocus}}
      {{#unless hideNormalItemFooter}}
      {{#if usesRichDescription}}
        <div class="stacked-field cypherv2-rich-description">
          <span>{{localize "CYPHERV2.Common.Description"}}</span>
          {{formInput systemFields.description name="system.description" value=source.system.description enriched=enriched.description elementType="prose-mirror" toggled=true disabled=(not editable) documentUUID=item.uuid}}
        </div>
      {{else}}
        <label class="stacked-field">
          <span>{{localize "CYPHERV2.Common.Description"}}</span>
          <textarea name="system.description">{{system.description}}</textarea>
        </label>
      {{/if}}
      {{/unless}}
    {{/unless}}
    {{#unless hideNormalItemFooter}}
    <div class="status-grid">
      <article class="status-card">
        <h2>{{localize "CYPHERV2.Item.Automation"}}</h2>
        <p>{{system.automation.mode}}</p>
      </article>
      <article class="status-card">
        <h2>{{localize "CYPHERV2.Item.RuleElements"}}</h2>
        <p>{{system.ruleElements.length}}</p>
      </article>
    </div>
    {{/unless}}
  </section>

  {{#unless hideNormalItemFooter}}
  <section class="phase-notice">
    <strong>{{localize "CYPHERV2.Phase1.Title"}}</strong>
    <span>{{localize "CYPHERV2.Phase1.ItemMessage"}}</span>
  </section>
  {{/unless}}
</div>
