<div class="cypherv2-sheet cypherv2-item{{#if isCompactRuleItem}} compact-rule-item{{/if}}{{#if usesCleanItemHeader}} clean-item-sheet{{/if}}">
  {{#if usesCleanItemHeader}}
    <header class="compact-item-header{{#if weaponDefaultPoolOptions.length}} weapon-item-header{{/if}}">
      <img class="compact-item-portrait" src="{{item.img}}" alt="{{item.name}}" data-edit="img" {{#if editable}}data-action="editImage" role="button" tabindex="0" title="{{localize 'CYPHERV2.Common.EditImage'}}"{{/if}}>
      <label class="compact-item-name">
        <span>{{localize "CYPHERV2.Common.Name"}}</span>
        <input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'CYPHERV2.Common.Name'}}">
      </label>
      {{#if weaponDefaultPoolOptions.length}}<label class="compact-mechanic-field weapon-default-pool" title="{{localize 'CYPHERV2.Combat.Weapon.DefaultPoolHint'}}"><span>{{localize "CYPHERV2.Pools.Pool"}}</span><select name="system.defaultPool">{{#each weaponDefaultPoolOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}</select></label>{{/if}}
    </header>
  {{else}}
    <header class="sheet-header">
      <img class="portrait" src="{{item.img}}" alt="{{item.name}}" data-edit="img" {{#if editable}}data-action="editImage" role="button" tabindex="0" title="{{localize 'CYPHERV2.Common.EditImage'}}"{{/if}}>
      <div class="identity">
        <input class="document-name" name="name" type="text" value="{{item.name}}" placeholder="{{localize 'CYPHERV2.Common.Name'}}">
        <p class="document-type">{{localize "CYPHERV2.Common.Type"}}: {{item.type}}</p>
        <label>{{localize "CYPHERV2.Item.Slug"}} <input name="system.slug" type="text" value="{{system.slug}}"></label>
      </div>
    </header>
  {{/if}}

  <section class="item-content" data-item-sheet-scroll>
    {{#if isAbility}}
      <section class="compact-rule-layout ability-rule-layout">
        <div class="compact-mechanics-grid ability-core-mechanics">
          <div class="compact-mechanic-field ability-cost-field">
            <span>{{localize "CYPHERV2.Ability.Cost"}}</span>
            <input name="system.cost.amount" type="number" min="0" step="1" value="{{system.cost.amount}}">
          </div>
          <label class="compact-mechanic-checkbox ability-scalable-cost"><input name="system.cost.scalable" type="checkbox" {{checked system.cost.scalable}}> {{localize "CYPHERV2.Ability.ScalableCost"}}</label>
          <fieldset class="compact-mechanic-field ability-pool-field">
            <legend>{{localize "CYPHERV2.Ability.AllowedPools"}}</legend>
            <div class="ability-pool-toggles">{{#each abilityAllowedPoolOptions as |option|}}<label class="ability-pool-toggle"><input type="checkbox" value="{{option.value}}" data-ability-allowed-pool {{checked option.selected}}> <span>{{option.label}}</span></label>{{/each}}{{#unless system.cost.allowedPools.length}}<small class="ability-no-pool">{{localize "CYPHERV2.Ability.NoPool"}}</small>{{/unless}}</div>
          </fieldset>
          <label class="compact-mechanic-field ability-edge-field"><span>{{localize "CYPHERV2.Ability.IgnoresEdge"}}</span><span class="ability-edge-control"><input name="system.cost.ignoresEdge" type="checkbox" {{checked system.cost.ignoresEdge}}></span></label>
        </div>
        <div class="stacked-field cypherv2-rich-description compact-rule-description">
          <span>{{localize "CYPHERV2.Common.Description"}}</span>
          {{formInput systemFields.description name="system.description" value=source.system.description enriched=enriched.description elementType="prose-mirror" toggled=true disabled=(not editable) documentUUID=item.uuid}}
        </div>
        <details class="compact-technical-area">
          <summary><i class="fa-solid fa-gear" aria-hidden="true"></i> {{localize "CYPHERV2.Item.AdvancedTechnical"}}</summary>
          {{#if abilityGenreReview}}<dl class="technical-provenance genre-ability-review-metadata"><dt>{{localize "CYPHERV2.Genre.Review.Catalog"}}</dt><dd>{{abilityGenreReview.catalogLabel}}</dd><dt>{{localize "CYPHERV2.Genre.Review.Membership"}}</dt><dd>{{abilityGenreReview.genresLabel}}</dd><dt>{{localize "CYPHERV2.Genre.Review.ProgressionBand"}}</dt><dd>{{abilityGenreReview.progressionBandLabel}}</dd>{{#if abilityGenreReview.minimumSuperheroRank}}<dt>{{localize "CYPHERV2.Genre.MinimumSuperheroRank"}}</dt><dd>{{abilityGenreReview.minimumSuperheroRank}}</dd>{{/if}}</dl>{{/if}}
          <div class="compact-mechanics-grid ability-runtime-mechanics">
            <label class="compact-mechanic-field">{{localize "CYPHERV2.Ability.Activation.Label"}}
              <select name="system.activation">{{#each abilityActivationOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}</select>
            </label>
            <label class="compact-mechanic-field">{{localize "CYPHERV2.Ability.Roll.Label"}}
              <select name="system.roll">{{#each abilityRollOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}</select>
            </label>
            {{#if abilityMechanics.showRollModifier}}<label class="compact-mechanic-field">{{abilityMechanics.rollModifierLabel}} <input name="system.rollModifier" type="number" min="-10" max="10" step="1" value="{{system.rollModifier}}"></label>{{/if}}
            {{#if abilityMechanics.showAttackModifier}}<label class="compact-mechanic-field">{{localize "CYPHERV2.Ability.AttackModifier"}} <input name="system.attackModifier" type="number" min="-10" max="10" step="1" value="{{system.attackModifier}}"></label>{{/if}}
            {{#if abilityMechanics.showDamage}}<label class="compact-mechanic-field">{{localize "CYPHERV2.Combat.Damage"}} <input name="system.damage" type="number" min="0" step="1" value="{{system.damage}}"></label>{{/if}}
            {{#if abilityMechanics.showWoundSeverity}}<label class="compact-mechanic-field">{{localize "CYPHERV2.Npc.WoundSeverity"}}
              <select name="system.woundSeverity">{{#each abilityWoundOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}</select>
            </label>{{/if}}
            {{#if abilityMechanics.showRange}}<label class="compact-mechanic-field">{{localize "CYPHERV2.Combat.Range.Label"}} <input name="system.range" type="text" value="{{system.range}}"></label>{{/if}}
            {{#if abilityMechanics.showTargetMode}}<label class="compact-mechanic-field">{{localize "CYPHERV2.Ability.Targeting"}}
              <select name="system.targetMode">{{#each abilityTargetOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}</select>
            </label>{{/if}}
          </div>
          <div class="compact-technical-grid">
            <label class="compact-mechanic-field">{{localize "CYPHERV2.Item.Slug"}} <input name="system.slug" type="text" value="{{system.slug}}"></label>
            <label class="compact-mechanic-field">{{localize "CYPHERV2.Character.Tier"}} <input name="system.tier" type="number" min="0" step="1" value="{{system.tier}}"></label>
            <label class="compact-mechanic-field">{{localize "CYPHERV2.Skill.Category"}} <input name="system.category" type="text" value="{{system.category}}"></label>
            <span>{{localize "CYPHERV2.Item.Automation"}}: {{system.automation.mode}}</span>
            <span>{{localize "CYPHERV2.Item.RuleElements"}}: {{system.ruleElements.length}}</span>
          </div>
          {{#if hasGrantProvenance}}<dl class="technical-provenance"><dt>{{localize "CYPHERV2.Item.Provenance"}}</dt><dd>{{system.grantedBy.kind}} · {{system.grantedBy.status}}</dd><dt>{{localize "CYPHERV2.Item.SourceUuid"}}</dt><dd>{{system.grantedBy.sourceUuid}}</dd><dt>{{localize "CYPHERV2.Item.InstanceId"}}</dt><dd>{{system.grantedBy.instanceId}}</dd><dt>{{localize "CYPHERV2.Item.GrantId"}}</dt><dd>{{system.grantedBy.grantId}}</dd></dl>{{/if}}
          {{#if system.sourceFocusUuid}}<dl class="technical-provenance"><dt>{{localize "CYPHERV2.Item.FocusUuid"}}</dt><dd>{{system.sourceFocusUuid}}</dd><dt>{{localize "CYPHERV2.Item.FocusNodeId"}}</dt><dd>{{system.sourceNodeId}}</dd></dl>{{/if}}
        </details>
      </section>
    {{/if}}
    {{#if isSkill}}
      <section class="compact-rule-layout skill-rule-layout">
        <div class="compact-mechanics-grid skill-core-mechanics">
        <label class="compact-mechanic-field">{{localize "CYPHERV2.Skill.Rank"}}
          <select name="system.rank">
            {{#each skillRankOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}
          </select>
        </label>
        </div>
        {{#if skillOptionalMechanics}}
        <div class="compact-mechanics-grid skill-optional-mechanics">
          <label class="compact-mechanic-field">{{localize "CYPHERV2.Skill.DefaultPool"}}
          <select name="system.defaultPool">
            {{#each skillPoolOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}
          </select>
          </label>
          <label class="compact-mechanic-field">{{localize "CYPHERV2.Skill.Category"}} <input name="system.category" type="text" value="{{system.category}}"></label>
          <label class="compact-mechanic-field compact-context-field">{{localize "CYPHERV2.Combat.Modification.Contexts"}}
          <select name="system.contexts" multiple size="3">
            {{#each skillContextOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}
          </select>
          </label>
          <label class="compact-mechanic-checkbox"><input name="system.initiative" type="checkbox" {{checked system.initiative}}> {{localize "CYPHERV2.Skill.Initiative"}}</label>
        </div>
        {{/if}}
        <div class="stacked-field cypherv2-rich-description compact-rule-description">
          <span>{{localize "CYPHERV2.Common.Description"}}</span>
          {{formInput systemFields.description name="system.description" value=source.system.description enriched=enriched.description elementType="prose-mirror" toggled=true disabled=(not editable) documentUUID=item.uuid}}
        </div>
        <details class="compact-technical-area">
          <summary><i class="fa-solid fa-gear" aria-hidden="true"></i> {{localize "CYPHERV2.Item.AdvancedTechnical"}}</summary>
          {{#unless skillOptionalMechanics}}
            <section class="technical-skill-options">
              <h3>{{localize "CYPHERV2.Skill.OptionalMechanics"}}</h3>
              <div class="compact-technical-grid">
                <label class="compact-mechanic-field">{{localize "CYPHERV2.Skill.DefaultPool"}} <select name="system.defaultPool">{{#each skillPoolOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}</select></label>
                <label class="compact-mechanic-field">{{localize "CYPHERV2.Skill.Category"}} <input name="system.category" type="text" value="{{system.category}}"></label>
                <label class="compact-mechanic-field compact-context-field">{{localize "CYPHERV2.Combat.Modification.Contexts"}} <select name="system.contexts" multiple size="3">{{#each skillContextOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}</select></label>
                <label class="compact-mechanic-checkbox"><input name="system.initiative" type="checkbox" {{checked system.initiative}}> {{localize "CYPHERV2.Skill.Initiative"}}</label>
              </div>
            </section>
          {{/unless}}
          <div class="compact-technical-grid">
            <label class="compact-mechanic-field">{{localize "CYPHERV2.Item.Slug"}} <input name="system.slug" type="text" value="{{system.slug}}"></label>
            <label class="compact-mechanic-field">{{localize "CYPHERV2.Skill.MinimumTier"}} <input name="system.acquisition.minimumTier" type="number" min="1" value="{{system.acquisition.minimumTier}}"></label>
            <label class="compact-mechanic-field">{{localize "CYPHERV2.Skill.GrantedBy"}} <input name="system.acquisition.grantedByUuid" type="text" value="{{system.acquisition.grantedByUuid}}"></label>
            <span>{{localize "CYPHERV2.Item.Automation"}}: {{system.automation.mode}}</span>
            <span>{{localize "CYPHERV2.Item.RuleElements"}}: {{system.ruleElements.length}}</span>
          </div>
          <label class="stacked-field technical-notes"><span>{{localize "CYPHERV2.Skill.AcquisitionNotes"}}</span><textarea name="system.acquisition.notes">{{system.acquisition.notes}}</textarea></label>
          {{#if hasGrantProvenance}}<dl class="technical-provenance"><dt>{{localize "CYPHERV2.Item.Provenance"}}</dt><dd>{{system.grantedBy.kind}} · {{system.grantedBy.status}}</dd><dt>{{localize "CYPHERV2.Item.SourceUuid"}}</dt><dd>{{system.grantedBy.sourceUuid}}</dd><dt>{{localize "CYPHERV2.Item.InstanceId"}}</dt><dd>{{system.grantedBy.instanceId}}</dd><dt>{{localize "CYPHERV2.Item.GrantId"}}</dt><dd>{{system.grantedBy.grantId}}</dd></dl>{{/if}}
        </details>
      </section>
    {{/if}}
    {{#if isEquipment}}
      <section class="compact-rule-layout inventory-item-sheet-layout">
        <div class="compact-mechanics-grid inventory-item-core-mechanics">
          <label class="compact-mechanic-field">{{localize "CYPHERV2.Inventory.Quantity"}} <input name="system.quantity" type="number" min="0" step="1" value="{{system.quantity}}"></label>
          <label class="compact-mechanic-field">{{localize "CYPHERV2.Inventory.Level"}} <input name="system.level" type="number" min="0" step="1" value="{{system.level}}"></label>
          <label class="compact-mechanic-field">{{localize "CYPHERV2.Inventory.Price"}} <input name="system.price" type="text" value="{{system.price}}"></label>
          <label class="compact-mechanic-checkbox inventory-item-toggle"><input name="system.equipped" type="checkbox" {{checked system.equipped}}> <span>{{localize "CYPHERV2.Combat.Equipped"}}</span></label>
        </div>
        <div class="stacked-field cypherv2-rich-description compact-rule-description">
          <span>{{localize "CYPHERV2.Common.Description"}}</span>
          {{formInput systemFields.description name="system.description" value=source.system.description enriched=enriched.description elementType="prose-mirror" toggled=true disabled=(not editable) documentUUID=item.uuid}}
        </div>
        <details class="compact-technical-area"><summary><i class="fa-solid fa-gear" aria-hidden="true"></i> {{localize "CYPHERV2.Item.AdvancedTechnical"}}</summary><div class="compact-technical-grid"><label class="compact-mechanic-field">{{localize "CYPHERV2.Item.Slug"}} <input name="system.slug" type="text" value="{{system.slug}}"></label><span>{{localize "CYPHERV2.Item.RuleElements"}}: {{system.ruleElements.length}}</span></div></details>
      </section>
    {{/if}}
    {{#if isCypher}}
      <section class="compact-rule-layout inventory-item-sheet-layout cypher-item-sheet-layout">
        <div class="compact-mechanics-grid inventory-item-core-mechanics">
          <label class="compact-mechanic-field">{{localize "CYPHERV2.Cypher.Manifestation.Label"}} <select name="system.manifestation">{{#each cypherManifestationOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}</select></label>
          <label class="compact-mechanic-field">{{localize "CYPHERV2.Cypher.Form"}} <input name="system.form" type="text" value="{{system.form}}"></label>
          <label class="compact-mechanic-field">{{localize "CYPHERV2.Cypher.Power.Label"}} <select name="system.power">{{#each cypherPowerOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}</select></label>
          <label class="compact-mechanic-field">{{localize "CYPHERV2.Inventory.Level"}} <input type="number" value="{{cypherEffectiveLevel}}" disabled></label>
        </div>
        <div class="stacked-field cypherv2-rich-description compact-rule-description">
          <span>{{localize "CYPHERV2.Common.Description"}}</span>
          {{formInput systemFields.description name="system.description" value=source.system.description enriched=enriched.description elementType="prose-mirror" toggled=true disabled=(not editable) documentUUID=item.uuid}}
        </div>
        <details class="compact-technical-area">
          <summary><i class="fa-solid fa-gear" aria-hidden="true"></i> {{localize "CYPHERV2.Item.AdvancedTechnical"}}</summary>
          <div class="compact-technical-grid">
            <label class="compact-mechanic-checkbox"><input name="system.levelOverride" type="checkbox" {{checked system.levelOverride}}> <span>{{localize "CYPHERV2.Cypher.LevelOverride"}}</span></label>
            <label class="compact-mechanic-field">{{localize "CYPHERV2.Cypher.OverrideLevel"}} <input name="system.level" type="number" min="1" step="1" value="{{system.level}}"></label>
            <label class="compact-mechanic-field">{{localize "CYPHERV2.Skill.Category"}} <input name="system.category" type="text" value="{{system.category}}"></label>
            <label class="compact-mechanic-field">{{localize "CYPHERV2.Item.Slug"}} <input name="system.slug" type="text" value="{{system.slug}}"></label>
            <span>{{localize "CYPHERV2.Item.RuleElements"}}: {{system.ruleElements.length}}</span>
          </div>
        </details>
      </section>
    {{/if}}
    {{#if isArtifact}}
      <section class="compact-rule-layout inventory-item-sheet-layout artifact-item-sheet-layout">
        <div class="compact-mechanics-grid inventory-item-core-mechanics">
          <label class="compact-mechanic-field">{{localize "CYPHERV2.Artifact.LevelFormula"}} <input name="system.level" type="text" value="{{system.level}}"></label>
          <div class="compact-depletion-controls artifact-depletion-controls">
            <label class="compact-mechanic-checkbox"><input name="system.depletion.enabled" type="checkbox" {{checked system.depletion.enabled}}> <span>{{localize "CYPHERV2.Depletion.Enabled"}}</span></label>
            <label class="compact-depletion-formula">{{localize "CYPHERV2.Depletion.Formula"}} <input name="system.depletion.formula" type="text" value="{{system.depletion.formula}}"></label>
            <label class="compact-mechanic-checkbox compact-depleted-control {{#if system.depleted}}is-depleted{{/if}}"><input name="system.depleted" type="checkbox" {{checked system.depleted}}> <span>{{localize "CYPHERV2.Artifact.Depleted"}}</span></label>
          </div>
        </div>
        {{#if system.depletion.enabled}}{{#unless system.depleted}}<button type="button" class="compact-inline-action" data-action="rollDepletion"><i class="fa-solid fa-dice" aria-hidden="true"></i> {{localize "CYPHERV2.Depletion.Roll"}}</button>{{/unless}}{{/if}}
        <div class="stacked-field cypherv2-rich-description compact-rule-description">
          <span>{{localize "CYPHERV2.Common.Description"}}</span>
          {{formInput systemFields.description name="system.description" value=source.system.description enriched=enriched.description elementType="prose-mirror" toggled=true disabled=(not editable) documentUUID=item.uuid}}
        </div>
        <details class="compact-technical-area">
          <summary><i class="fa-solid fa-gear" aria-hidden="true"></i> {{localize "CYPHERV2.Item.AdvancedTechnical"}}</summary>
          <div class="compact-technical-grid">
            <label class="compact-mechanic-field">{{localize "CYPHERV2.Depletion.Threshold"}} <input name="system.depletion.threshold" type="number" min="1" step="1" value="{{system.depletion.threshold}}"></label>
            <label class="compact-mechanic-field">{{localize "CYPHERV2.Item.Slug"}} <input name="system.slug" type="text" value="{{system.slug}}"></label>
            <span>{{localize "CYPHERV2.Item.RuleElements"}}: {{system.ruleElements.length}}</span>
          </div>
        </details>
      </section>
    {{/if}}
    {{#if isWeapon}}
      <section class="compact-rule-layout weapon-item-sheet-layout">
        <div class="compact-mechanics-grid weapon-core-mechanics">
          <label class="compact-mechanic-field">{{localize "CYPHERV2.Combat.Category"}} <select name="system.category">{{#each weaponCategoryOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}</select></label>
          <label class="compact-mechanic-field">{{localize "CYPHERV2.Combat.Weapon.Family.Label"}} <input name="system.family" type="text" value="{{weaponFamilyDisplay}}" list="cypherv2-weapon-family-suggestions" placeholder="{{localize 'CYPHERV2.Common.None'}}"></label>
          <datalist id="cypherv2-weapon-family-suggestions">{{#each weaponFamilySuggestions as |option|}}<option value="{{option.value}}"></option>{{/each}}</datalist>
          <label class="compact-mechanic-field">{{localize "CYPHERV2.Combat.Weapon.BaseDamage"}} <input type="number" value="{{system.baseDamage}}" disabled></label>
          <label class="compact-mechanic-field">{{localize "CYPHERV2.Combat.Range.Label"}} <select name="system.rangeCategory">{{#each rangeOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}</select></label>
          <label class="compact-mechanic-field">{{localize "CYPHERV2.Roll.SkillLevel"}} <select name="system.skillLevel">{{#each weaponSkillLevelOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}</select></label>
        </div>
        <details class="compact-technical-area weapon-resource-options" data-persistent-disclosure="combat-resources" {{#if combatResourcesExpanded}}open{{/if}}>
          <summary>{{localize "CYPHERV2.Combat.Weapon.Resources"}}</summary>
          <div class="compact-technical-grid">
            <div class="weapon-ammo-line"><label class="compact-mechanic-checkbox"><input name="system.ammo.enabled" type="checkbox" {{checked system.ammo.enabled}}> <span>{{localize "CYPHERV2.Combat.AmmoEnabled"}}</span></label>{{#if system.ammo.enabled}}<label class="compact-mechanic-field compact-ammo-field">{{localize "CYPHERV2.Combat.AmmoCurrent"}} <input name="system.ammo.value" type="number" min="0" value="{{system.ammo.value}}"></label><span class="ammo-separator">/</span><label class="compact-mechanic-field compact-ammo-field">{{localize "CYPHERV2.Combat.AmmoMaximum"}} <input name="system.ammo.max" type="number" min="0" value="{{system.ammo.max}}"></label><label class="compact-mechanic-field compact-ammo-field">{{localize "CYPHERV2.Combat.AmmoPerAttack"}} <input name="system.ammo.perAttack" type="number" min="1" value="{{system.ammo.perAttack}}"></label><button type="button" class="cypherv2-icon-action weapon-reload-action" data-action="reloadWeapon" title="{{localize 'CYPHERV2.Combat.Weapon.ReloadToMaximum'}}" aria-label="{{localize 'CYPHERV2.Combat.Weapon.ReloadToMaximum'}}"><i class="fa-solid fa-rotate-right" aria-hidden="true"></i></button>{{/if}}</div>
            <div class="compact-depletion-controls">
              <label class="compact-mechanic-checkbox"><input name="system.depletion.enabled" type="checkbox" {{checked system.depletion.enabled}}> <span>{{localize "CYPHERV2.Depletion.Enabled"}}</span></label>
              {{#if system.depletion.enabled}}
                <div class="compact-depletion-rule"><span>{{localize "CYPHERV2.Depletion.DepletesOn"}}</span><input data-depletion-threshold type="text" value="{{combatDepletionThreshold}}" inputmode="numeric" aria-label="{{localize 'CYPHERV2.Depletion.Threshold'}}"><span>in 1d</span><input data-depletion-sides type="number" min="2" max="1000" step="1" value="{{combatDepletionSides}}" aria-label="{{localize 'CYPHERV2.Depletion.DieSides'}}"></div>
                <label class="compact-mechanic-checkbox compact-depleted-control {{#if system.depleted}}is-depleted{{/if}}"><input name="system.depleted" type="checkbox" {{checked system.depleted}}> <span>{{localize "CYPHERV2.Depletion.Depleted"}}</span></label>
              {{/if}}
            </div>
          </div>
        </details>
        {{#if isHeavyWeapon}}<p class="compact-rule-note">{{localize "CYPHERV2.Combat.Weapon.HeavyTwoHands"}}</p>{{/if}}
        <div class="stacked-field cypherv2-rich-description compact-rule-description"><span>{{localize "CYPHERV2.Common.Description"}}</span>{{formInput systemFields.description name="system.description" value=source.system.description enriched=enriched.description elementType="prose-mirror" toggled=true disabled=(not editable) documentUUID=item.uuid}}</div>
