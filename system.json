{
  "id": "cypherv2",
  "title": "Cypher V2",
  "description": "A modern, extensible implementation of Cypher V2 for Foundry Virtual Tabletop.",
  "version": "0.1.0-beta.3",
  "manifest": "https://raw.githubusercontent.com/SebsokK/cypherv2/main/system.json",
  "download": "https://github.com/SebsokK/cypherv2/releases/download/v0.1.0-beta.3/cypherv2.zip",
  "compatibility": {
    "minimum": "14",
    "verified": "14.360"
  },
  "authors": [
    {
      "name": "Cypher V2 Contributors"
    }
  ],
  "esmodules": ["dist/cypherv2.mjs"],
  "styles": ["dist/cypherv2.css"],
  "media": [
    {
      "type": "setup",
      "url": "systems/cypherv2/assets/cypher2meta.jpg",
      "thumbnail": "systems/cypherv2/assets/cypher2meta.jpg"
    }
  ],
  "packs": [
    {
      "name": "descriptors",
      "label": "Descriptors",
      "path": "packs/descriptors",
      "type": "Item",
      "system": "cypherv2"
    },
    {
      "name": "skills",
      "label": "Skills",
      "path": "packs/skills",
      "type": "Item",
      "system": "cypherv2"
    },
    {
      "name": "weapons-and-armors",
      "label": "Weapons & Armors",
      "path": "packs/weapons-and-armors",
      "type": "Item",
      "system": "cypherv2"
    },
    {
      "name": "type-abilities",
      "label": "Type Abilities",
      "path": "packs/type-abilities",
      "type": "Item",
      "system": "cypherv2"
    },
    {
      "name": "types",
      "label": "Types",
      "path": "packs/types",
      "type": "Item",
      "system": "cypherv2"
    },
    {
      "name": "species",
      "label": "Species",
      "path": "packs/species",
      "type": "Item",
      "system": "cypherv2"
    },
    {
      "name": "genre-abilities",
      "label": "Genre Abilities",
      "path": "packs/genre-abilities",
      "type": "Item",
      "system": "cypherv2"
    },
    {
      "name": "genres",
      "label": "Genres",
      "path": "packs/genres",
      "type": "Item",
      "system": "cypherv2"
    },
    {
      "name": "focus-abilities",
      "label": "Focus Abilities",
      "path": "packs/focus-abilities",
      "type": "Item",
      "system": "cypherv2"
    },
    {
      "name": "foci",
      "label": "Foci",
      "path": "packs/foci",
      "type": "Item",
      "system": "cypherv2"
    },
    {
      "name": "cyphers",
      "label": "Cyphers",
      "path": "packs/cyphers",
      "type": "Item",
      "system": "cypherv2"
    },
    {
      "name": "cypher-tables",
      "label": "Cypher Tables",
      "path": "packs/cypher-tables",
      "type": "RollTable",
      "system": "cypherv2"
    }
  ],
  "documentTypes": {
    "Actor": {
      "character": {
        "htmlFields": [
          "description",
          "notes",
          "gmNotes",
          "advancement.notes",
          "wounds.minor.*.description",
          "wounds.moderate.*.description",
          "wounds.major.*.description"
        ]
      },
      "npc": {
        "htmlFields": ["description", "notes", "gmNotes", "gmIntrusion"]
      }
    },
    "Item": {
      "ability": {"htmlFields": ["description"]},
      "skill": {"htmlFields": ["acquisition.notes"]},
      "weapon": {"htmlFields": ["description"]},
      "armor": {"htmlFields": ["description"]},
      "shield": {"htmlFields": ["description", "wounds.minor.*.description", "wounds.moderate.*.description", "wounds.major.*.description"]},
      "equipment": {"htmlFields": ["description"]},
      "cypher": {"htmlFields": ["description"]},
      "artifact": {"htmlFields": ["description"]},
      "descriptor": {"htmlFields": ["description"]},
      "characterType": {"htmlFields": ["description", "backgroundOptions", "equipmentNotes"]},
      "focus": {"htmlFields": ["description"]},
      "genre": {"htmlFields": ["description"]},
      "species": {"htmlFields": ["description"]}
    }
  },
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "socket": true,
  "grid": {
    "distance": 1.5,
    "units": "m"
  },
  "license": "LICENSE.md",
  "readme": "README.md"
}
