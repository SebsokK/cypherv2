{
  "name": "cypherv2-foundryvtt",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "description": "A modern Foundry VTT v14 system for Cypher V2.",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
